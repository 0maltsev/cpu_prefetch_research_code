{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:frozen-schedule:v2",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "arrival_family", "deadline_ticks", "origin_ticks", "horizon_ticks"],
      "properties": {
        "schema_version": {"const": "cpu-prefetch-stage17-frozen-schedule/2"},
        "arrival_family": {"const": "OPEN_LOOP_FROZEN"},
        "deadline_ticks": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "origin_ticks": {"type": "integer", "minimum": 0},
        "horizon_ticks": {"type": "integer", "minimum": 1}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "arrival_family", "duration_ticks", "maximum_attempts"],
      "properties": {
        "schema_version": {"const": "cpu-prefetch-stage17-frozen-schedule/2"},
        "arrival_family": {"const": "CONTINUOUS_READY"},
        "duration_ticks": {"type": "integer", "minimum": 1},
        "maximum_attempts": {"type": "integer", "minimum": 1}
      }
    }
  ]
}
