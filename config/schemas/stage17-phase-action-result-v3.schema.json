{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:cpu-prefetch:stage17:phase-action-result:v3",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "result_id", "request_id", "request_sha256", "action_id", "stand_id", "authorization_id", "authorization_sha256", "attempt_id", "runtime_binding", "release_binding", "predecessor_resolutions", "artifacts", "started_at_utc", "completed_at_utc", "duration_ns", "terminal_state", "restoration_verified", "quarantined", "synthetic_test_only", "phase18_authority"],
  "properties": {"schema_version": {"const": "cpu-prefetch-stage17-phase-action-result/3"}, "result_id": {"type": "string", "minLength": 1}, "request_id": {"type": "string", "minLength": 1}, "request_sha256": {"$ref": "#/$defs/sha256"}, "action_id": {"$ref": "#/$defs/action"}, "stand_id": {"type": "string", "minLength": 1}, "authorization_id": {"type": "string", "minLength": 1}, "authorization_sha256": {"$ref": "#/$defs/sha256"}, "attempt_id": {"type": "string", "minLength": 1}, "runtime_binding": {"type": "object"}, "release_binding": {"type": "object"}, "predecessor_resolutions": {"type": "array", "minItems": 3, "uniqueItems": true}, "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}, "started_at_utc": {"$ref": "#/$defs/utc"}, "completed_at_utc": {"$ref": "#/$defs/utc"}, "duration_ns": {"type": "integer", "minimum": 0}, "terminal_state": {"type": "string", "minLength": 1}, "restoration_verified": {"type": "boolean"}, "quarantined": {"type": "boolean"}, "synthetic_test_only": {"type": "boolean"}, "phase18_authority": {"const": false}},
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "utc": {"type": "string", "format": "date-time", "pattern": "Z$"}, "action": {"enum": ["Q15-R", "Q15-W", "Q16a", "Q16b", "Q16c", "STAGE17-BLINDED-PILOT"]}, "artifact": {"type": "object", "additionalProperties": false, "required": ["role", "schema_identity", "media_type", "file_name", "size_bytes", "sha256"], "properties": {"role": {"type": "string", "minLength": 1}, "schema_identity": {"type": "string", "minLength": 1}, "media_type": {"enum": ["application/json", "application/octet-stream"]}, "file_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}
}
