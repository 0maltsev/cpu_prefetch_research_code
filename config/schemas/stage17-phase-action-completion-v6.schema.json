{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:phase-action-completion:v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "completion_id",
    "attempt_id",
    "action_id",
    "authorization_sha256",
    "request_sha256",
    "runtime_sha256",
    "result",
    "artifact_bindings",
    "leader_reaped",
    "process_group_gone",
    "restoration_verified",
    "live_restoration_readback",
    "quarantined",
    "completed_at_utc",
    "phase18_authority",
    "resource_admission"
  ],
  "properties": {
    "schema_version": {
      "const": "cpu-prefetch-stage17-phase-action-completion/6"
    },
    "completion_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "enum": [
        "Q16a",
        "Q16b",
        "Q16c"
      ]
    },
    "authorization_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "result": {
      "$ref": "#/$defs/file"
    },
    "artifact_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "leader_reaped": {
      "const": true
    },
    "process_group_gone": {
      "const": true
    },
    "restoration_verified": {
      "type": "boolean"
    },
    "live_restoration_readback": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/readback"
      }
    },
    "quarantined": {
      "type": "boolean"
    },
    "completed_at_utc": {
      "$ref": "#/$defs/utc"
    },
    "phase18_authority": {
      "const": false
    },
    "resource_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_available_bytes",
        "filesystem_available_bytes",
        "filesystem_device",
        "required_memory_bytes",
        "required_free_disk_bytes",
        "observed_at_utc",
        "reservation_established"
      ],
      "properties": {
        "memory_available_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "filesystem_available_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "filesystem_device": {
          "type": "integer",
          "minimum": 0
        },
        "required_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "required_free_disk_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "observed_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "reservation_established": {
          "const": false
        },
        "program_scope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "retained_program_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6000000000000
        },
        "remaining_program_quota_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6000000000000
        },
        "capture_ordinal": {
          "type": "integer",
          "minimum": 0
        }
      },
      "dependentRequired": {
        "program_scope_sha256": [
          "retained_program_bytes",
          "remaining_program_quota_bytes",
          "capture_ordinal"
        ],
        "retained_program_bytes": [
          "program_scope_sha256",
          "remaining_program_quota_bytes",
          "capture_ordinal"
        ],
        "remaining_program_quota_bytes": [
          "program_scope_sha256",
          "retained_program_bytes",
          "capture_ordinal"
        ],
        "capture_ordinal": [
          "program_scope_sha256",
          "retained_program_bytes",
          "remaining_program_quota_bytes"
        ]
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "action": {
      "enum": [
        "Q15-R",
        "Q15-W",
        "Q16a",
        "Q16b",
        "Q16c",
        "STAGE17-BLINDED-PILOT"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_name",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "expected_hex",
        "observed_hex",
        "matches"
      ],
      "properties": {
        "cpu": {
          "enum": [
            0,
            1,
            8,
            26
          ]
        },
        "expected_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "observed_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "matches": {
          "const": true
        }
      }
    }
  }
}
