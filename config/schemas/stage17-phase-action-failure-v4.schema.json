  "properties": {"schema_version": {"const": "cpu-prefetch-stage17-phase-action-failure/4"}, "failure_id": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string", "minLength": 1}, "action_id": {"$ref": "#/$defs/action"}, "authorization_sha256": {"$ref": "#/$defs/sha256"}, "request_sha256": {"$ref": "#/$defs/sha256"}, "runtime_sha256": {"$ref": "#/$defs/sha256"}, "failure_category": {"type": "string", "minLength": 1}, "failure_stage": {"type": "string", "minLength": 1}, "leader_reaped": {"type": "boolean"}, "process_group_gone": {"type": "boolean"}, "partial_retained": {"const": true}, "restoration_verified": {"type": "boolean"}, "recovery_readback": {"type": ["array", "null"], "items": {"$ref": "#/$defs/readback"}}, "quarantine_operation": {"type": "object", "additionalProperties": false, "required": ["performed", "record_sha256"], "properties": {"performed": {"type": "boolean"}, "record_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}}, "completed_at_utc": {"$ref": "#/$defs/utc"}, "phase18_authority": {"const": false}},
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "utc": {"type": "string", "format": "date-time", "pattern": "Z$"}, "action": {"enum": ["Q15-R", "Q15-W", "Q16a", "Q16b", "Q16c", "STAGE17-BLINDED-PILOT"]}, "readback": {"type": "object", "additionalProperties": false, "required": ["cpu", "requested_hex", "observed_hex", "matches"], "properties": {"cpu": {"enum": [0, 1, 26]}, "requested_hex": {"type": "string", "pattern": "^[0-9a-f]{16}$"}, "observed_hex": {"type": ["string", "null"], "pattern": "^[0-9a-f]{16}$"}, "matches": {"type": "boolean"}}}}
