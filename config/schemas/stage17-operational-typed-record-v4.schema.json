{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:operational-typed-record:v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "record_role", "subject_id", "source_bindings", "measurements", "outcome", "recorded_at_utc", "synthetic_test_only", "phase18_authority"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-operational-typed-record/4"},
    "record_id": {"type": "string", "minLength": 1},
    "record_role": {"enum": ["RUNTIME_IDENTITY", "TRUST_ANCHOR", "OWNER_ACCEPTANCE", "QUALIFICATION_NEAR_FAR", "QUALIFICATION_CLOCK", "QUALIFICATION_ATOMICS_LAYOUT", "QUALIFICATION_AFFINITY_MIGRATION", "QUALIFICATION_NUMA_PAGES", "QUALIFICATION_STORAGE_RECOVERY", "QUALIFICATION_HARDWARE_PREFETCH", "QUALIFICATION_STAND_PRESTATE", "QUALIFICATION_Q15_COLLECTOR", "PILOT_PLATFORM_MEASUREMENTS", "STORAGE_BUDGET", "CUSTODY_DOMAIN", "COPY_LEDGER", "RECOVERY_TEST"]},
    "subject_id": {"type": "string", "minLength": 1},
    "source_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/binding"}},
    "measurements": {"type": "object", "minProperties": 2},
    "outcome": {"enum": ["ACCEPTED", "VERIFIED"]},
    "recorded_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "synthetic_test_only": {"type": "boolean"},
    "phase18_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {"type": "object", "additionalProperties": false, "required": ["id", "size_bytes", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
