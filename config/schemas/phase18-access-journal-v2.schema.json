{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:cpu-prefetch:phase18:access-journal:v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "journal_id", "authorization", "signature", "trust_context_id", "trust_context_sha256", "synthetic_test_only", "transitions", "current_state_claim"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-phase18-access-journal/2"}, "journal_id": {"type": "string", "minLength": 1}, "authorization": {"$ref": "#/$defs/file"}, "signature": {"$ref": "#/$defs/file"}, "trust_context_id": {"type": "string", "minLength": 1}, "trust_context_sha256": {"$ref": "#/$defs/sha256"}, "synthetic_test_only": {"type": "boolean"},
    "transitions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["sequence_number", "from_state", "to_state", "previous_transition_sha256", "authorization_sha256", "evidence", "actor", "timestamp_utc", "authority_scope", "stage17_authority_used", "automatic_transition"], "properties": {"sequence_number": {"type": "integer", "minimum": 1}, "from_state": {"$ref": "#/$defs/state"}, "to_state": {"$ref": "#/$defs/state"}, "previous_transition_sha256": {"$ref": "#/$defs/sha256"}, "authorization_sha256": {"$ref": "#/$defs/sha256"}, "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}}, "actor": {"type": "string", "minLength": 1}, "timestamp_utc": {"$ref": "#/$defs/utc"}, "authority_scope": {"const": "PHASE18_ACCESS_TRANSITION_ONLY"}, "stage17_authority_used": {"const": false}, "automatic_transition": {"const": false}}}}, "current_state_claim": {"$ref": "#/$defs/state"}
  }, "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "utc": {"type": "string", "format": "date-time", "pattern": "Z$"}, "state": {"enum": ["PLANNED", "COLLECTED_SEALED", "TRAINING_OPEN", "SELECTION_FROZEN", "VALIDATION_UNSEALED", "H3_EVALUATED", "H1H2_RELEASED", "ARCHIVED"]}, "file": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}
}
