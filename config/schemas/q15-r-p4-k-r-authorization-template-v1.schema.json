      "verify_single_ed25519_allowed_signers_profile": "OPENSSH-ALLOWED-SIGNERS-SINGLE-ED25519-v1",
      "verify_principal_and_public_key_byte_equality": true,
      "verify_custody_receipt_without_private_path_or_bytes": true,
      "review_attempt_count": 1,
