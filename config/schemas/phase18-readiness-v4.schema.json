{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:cpu-prefetch:phase18:readiness:v4",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "readiness_id", "stage17_completion_sha256", "external_trust_anchor", "state", "authorization_issued", "created_at_utc", "phase18_authority"],
  "properties": {"schema_version": {"const": "cpu-prefetch-phase18-readiness/4"}, "readiness_id": {"type": "string", "minLength": 1}, "stage17_completion_sha256": {"$ref": "#/$defs/sha"}, "external_trust_anchor": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["anchor_id", "sha256", "public_key_fingerprint_sha256"], "properties": {"anchor_id": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}, "public_key_fingerprint_sha256": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"}}}]}, "state": {"enum": ["BLOCKED_EXTERNAL_PHASE18_TRUST_REQUIRED", "READY_FOR_SEPARATE_PHASE18_AUTHORIZATION"]}, "authorization_issued": {"const": false}, "created_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}, "phase18_authority": {"const": false}},
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
