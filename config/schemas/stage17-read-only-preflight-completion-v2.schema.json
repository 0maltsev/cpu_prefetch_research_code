    "actual_authority_sample_before_marker_utc": {"$ref": "#/$defs/actual_utc"}, "actual_authority_sample_before_first_transport_utc": {"$ref": "#/$defs/actual_utc"}, "actual_completed_at_utc": {"$ref": "#/$defs/actual_utc"}, "duration_ns": {"type": "integer", "minimum": 0},
