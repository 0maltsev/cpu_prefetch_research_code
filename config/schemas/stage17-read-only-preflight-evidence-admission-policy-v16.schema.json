{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:read-only-preflight-evidence-admission-policy:v16",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "policy_id", "policy_version", "protocol_version", "predecessor", "schema_bindings", "fixed_action_plan", "successor_action_plan", "operational_contract", "implementations", "operational_implementations", "operational_definitions", "entries", "action_readiness", "operational_admission", "default_action", "synthetic_bypass_available", "stage18_authority"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-read-only-preflight-evidence-admission-policy/16"},
    "policy_id": {"const": "STAGE17-READ-ONLY-PREFLIGHT-EVIDENCE-ADMISSION-POLICY-v16"}, "policy_version": {"const": "16"}, "protocol_version": {"const": "2.0.0-pre.3"},
    "predecessor": {"type": "object", "additionalProperties": false, "required": ["policy_v15", "adr_0130", "graph_sha256", "catalog_sha256", "genesis_file_sha256", "genesis_record_sha256", "resolution_schema_sha256"], "properties": {"policy_v15": {"$ref": "#/$defs/binding"}, "adr_0130": {"$ref": "#/$defs/binding"}, "graph_sha256": {"$ref": "#/$defs/sha256"}, "catalog_sha256": {"$ref": "#/$defs/sha256"}, "genesis_file_sha256": {"$ref": "#/$defs/sha256"}, "genesis_record_sha256": {"$ref": "#/$defs/sha256"}, "resolution_schema_sha256": {"$ref": "#/$defs/sha256"}}},
    "schema_bindings": {"type": "array", "minItems": 36, "maxItems": 36, "uniqueItems": true, "items": {"$ref": "#/$defs/binding"}},
    "fixed_action_plan": {"$ref": "#/$defs/binding"}, "successor_action_plan": {"$ref": "#/$defs/binding"}, "operational_contract": {"$ref": "#/$defs/binding"},
    "implementations": {"type": "object", "additionalProperties": false, "minProperties": 23, "maxProperties": 23, "patternProperties": {"^[a-z][a-z0-9_]+$": {"$ref": "#/$defs/binding"}}},
    "operational_implementations": {"type": "object", "additionalProperties": false, "required": ["semantic_admission", "phase_controller", "exit_state_machine", "pid_namespace_supervisor"], "properties": {"semantic_admission": {"$ref": "#/$defs/binding"}, "phase_controller": {"$ref": "#/$defs/binding"}, "exit_state_machine": {"$ref": "#/$defs/binding"}, "pid_namespace_supervisor": {"$ref": "#/$defs/binding"}}},
    "operational_definitions": {"type": "object", "additionalProperties": false, "required": ["external_contract", "fixed_phase_actions", "phase18_readiness_template", "phase18_authorization_draft"], "properties": {"external_contract": {"$ref": "#/$defs/binding"}, "fixed_phase_actions": {"$ref": "#/$defs/binding"}, "phase18_readiness_template": {"$ref": "#/$defs/binding"}, "phase18_authorization_draft": {"$ref": "#/$defs/binding"}}},
    "entries": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["input_id", "status", "verifier_id", "verifier_version"], "properties": {"input_id": {"pattern": "^S17-EXT-[0-9]{3}$"}, "status": {"const": "IMPLEMENTED"}, "verifier_id": {"type": "string", "minLength": 1}, "verifier_version": {"type": "string", "minLength": 1}}}},
    "action_readiness": {"const": {"actual_system_utc_required_for_execution": true, "caller_time_authority": false, "exact_transition_1_required": true, "pid_namespace_mapping_required_before_marker": true, "procfs_failure": "FAIL_CLOSED", "namespace_local_syscall_ids_only": true, "leader_reaped_and_process_group_gone_required_before_evidence": true, "durable_create_exclusive_marker_required": true, "global_monotonic_deadline_seconds": 180, "retry_allowed": false}},
    "operational_admission": {"const": {"all_ten_semantic_verifiers_implemented": true, "exact_artifact_bytes_rehashed": true, "signed_action_authority_verified_by_controller": true, "synthetic_requires_explicit_test_gate": true, "synthetic_resolves_operational_input": false, "phase18_chronology_separate": true}},
    "default_action": {"const": "REJECT_UNKNOWN_OR_SEMANTICALLY_INVALID"}, "synthetic_bypass_available": {"const": false}, "stage18_authority": {"const": false}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "binding": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}
}
