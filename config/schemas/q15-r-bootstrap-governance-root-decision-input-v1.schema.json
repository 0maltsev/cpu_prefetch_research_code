      "genesis_identity_or_witness_action_authorized": false,
      "offline_environment_access_or_inventory_authorized": false,
      "bootstrap_key_generation_import_copy_fingerprint_or_use_authorized": false,
      "private_key_path_bytes_passphrase_or_seed_collection_authorized": false,
      "custody_or_public_export_path_creation_authorized": false,
      "public_trust_artifact_creation_authorized": false,
      "signing_activation_rotation_revocation_or_recovery_authorized": false,
      "p4_k_a_or_p4_k_r_authorized": false,
      "stand_access_authorized": false,
      "q15_r_or_q15_w_authorized": false,
      "calibration_pilot_measurement_or_confirmatory_authorized": false
