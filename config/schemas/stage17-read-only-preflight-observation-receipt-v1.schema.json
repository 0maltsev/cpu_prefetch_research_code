{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:read-only-preflight-observation-receipt:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "authorization_id", "authorization_sha256", "resolution_id", "resolution_sha256", "transition_id", "transition_sha256", "action_plan_sha256", "executor_sha256", "collector_sha256", "ordinal", "observation_id", "rendered_program_sha256", "ssh_argv_sha256", "actual_started_at_utc", "actual_completed_at_utc", "duration_ns", "returncode", "failure", "stdout_size_bytes", "stdout_sha256", "stderr_size_bytes", "stderr_sha256", "attempt", "retry", "stage18_authority"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-read-only-preflight-observation-receipt/1"},
    "attempt_id": {"type": "string"}, "authorization_id": {"type": "string"}, "authorization_sha256": {"$ref": "#/$defs/sha256"},
    "resolution_id": {"type": "string"}, "resolution_sha256": {"$ref": "#/$defs/sha256"},
    "transition_id": {"type": "string"}, "transition_sha256": {"$ref": "#/$defs/sha256"},
    "action_plan_sha256": {"$ref": "#/$defs/sha256"}, "executor_sha256": {"$ref": "#/$defs/sha256"}, "collector_sha256": {"$ref": "#/$defs/sha256"},
    "ordinal": {"type": "integer", "minimum": 1, "maximum": 6}, "observation_id": {"type": "string"},
    "rendered_program_sha256": {"$ref": "#/$defs/sha256"}, "ssh_argv_sha256": {"$ref": "#/$defs/sha256"},
    "actual_started_at_utc": {"$ref": "#/$defs/utc"}, "actual_completed_at_utc": {"$ref": "#/$defs/utc"}, "duration_ns": {"type": "integer", "minimum": 0},
    "returncode": {"type": "integer"}, "failure": {"type": ["string", "null"]},
    "stdout_size_bytes": {"type": "integer", "minimum": 0}, "stdout_sha256": {"$ref": "#/$defs/sha256"},
    "stderr_size_bytes": {"type": "integer", "minimum": 0}, "stderr_sha256": {"$ref": "#/$defs/sha256"},
    "attempt": {"const": 1}, "retry": {"const": 0}, "stage18_authority": {"const": false}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}}
}
