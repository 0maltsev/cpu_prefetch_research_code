{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:pilot-session-completion:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "authorization_id", "authorization_sha256", "request_sha256", "plan_id", "plan_sha256", "stand_id", "run_count", "run_attempt_sha256s", "run_completion_sha256s", "sealed_manifest", "hardware_state", "started_at_utc", "completed_at_utc", "terminal_state", "all_runs_complete", "restoration_verified", "quarantined", "synthetic_test_only", "phase18_authority"],
  "properties": {"schema_version": {"const": "cpu-prefetch-stage17-pilot-session-completion/1"}, "session_id": {"type": "string", "minLength": 1}, "authorization_id": {"type": "string", "minLength": 1}, "authorization_sha256": {"$ref": "#/$defs/sha256"}, "request_sha256": {"$ref": "#/$defs/sha256"}, "plan_id": {"type": "string", "minLength": 1}, "plan_sha256": {"$ref": "#/$defs/sha256"}, "stand_id": {"type": "string", "minLength": 1}, "run_count": {"type": "integer", "minimum": 180}, "run_attempt_sha256s": {"type": "array", "minItems": 180, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}, "run_completion_sha256s": {"type": "array", "minItems": 180, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}, "sealed_manifest": {"$ref": "#/$defs/file"}, "hardware_state": {"$ref": "#/$defs/file"}, "started_at_utc": {"$ref": "#/$defs/utc"}, "completed_at_utc": {"$ref": "#/$defs/utc"}, "terminal_state": {"const": "PILOT_SESSION_COMPLETE_SEALED"}, "all_runs_complete": {"const": true}, "restoration_verified": {"const": true}, "quarantined": {"const": false}, "synthetic_test_only": {"type": "boolean"}, "phase18_authority": {"const": false}},
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "utc": {"type": "string", "format": "date-time", "pattern": "Z$"}, "file": {"type": "object", "additionalProperties": false, "required": ["file_name", "size_bytes", "sha256"], "properties": {"file_name": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}
}
