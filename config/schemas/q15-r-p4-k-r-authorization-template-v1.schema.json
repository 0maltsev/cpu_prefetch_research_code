    "required_evidence": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/nullInput"}},
    "prospective_outputs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/nullInput"}},
    "rollback": {"const": {
      "profile": "Q15-R-P4-K-R-READ-ONLY-STOP-RETAIN-REVIEW-EVIDENCE-v1",
      "on_failure": "STOP_RETAIN_COMPLETE_OR_PARTIAL_REVIEW_RECEIPT_WITHOUT_MUTATING_SOURCE_EVIDENCE",
      "delete_overwrite_retry_repair_or_cleanup_authorized": false,
