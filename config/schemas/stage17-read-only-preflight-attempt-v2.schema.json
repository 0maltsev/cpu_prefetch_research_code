{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:read-only-preflight-attempt:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "authorization_id", "authorization_sha256", "resolution_id", "resolution_sha256", "transition_id", "transition_sha256", "action_plan_sha256", "runtime_implementation_hashes", "ssh_argv_sha256", "rendered_programs", "actual_started_at_utc", "monotonic_deadline_ns", "attempt_number", "retry_allowed", "transport_may_start_after_durable_marker", "stage18_authority"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-read-only-preflight-attempt/2"},
    "attempt_id": {"type": "string", "minLength": 1},
    "authorization_id": {"type": "string", "minLength": 1},
    "authorization_sha256": {"$ref": "#/$defs/sha256"},
    "resolution_id": {"type": "string", "minLength": 1},
    "resolution_sha256": {"$ref": "#/$defs/sha256"},
    "transition_id": {"type": "string", "minLength": 1},
    "transition_sha256": {"$ref": "#/$defs/sha256"},
    "action_plan_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_implementation_hashes": {"type": "object", "minProperties": 7, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "ssh_argv_sha256": {"$ref": "#/$defs/sha256"},
    "rendered_programs": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/program"}},
    "actual_started_at_utc": {"$ref": "#/$defs/utc"},
    "monotonic_deadline_ns": {"type": "integer", "minimum": 1},
    "attempt_number": {"const": 1},
    "retry_allowed": {"const": false},
    "transport_may_start_after_durable_marker": {"const": true},
    "stage18_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "program": {"type": "object", "additionalProperties": false, "required": ["ordinal", "observation_id", "size_bytes", "sha256"], "properties": {"ordinal": {"type": "integer", "minimum": 1, "maximum": 6}, "observation_id": {"type": "string"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
