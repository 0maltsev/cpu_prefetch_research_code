{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:cpu-prefetch:stage17:phase-action-completion:v2", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "completion_id", "attempt_id", "action_id", "authorization_sha256", "request_sha256", "runtime_sha256", "result", "artifact_bindings", "leader_reaped", "process_group_gone", "restoration_verified", "quarantined", "completed_at_utc", "phase18_authority"],
  "properties": {"schema_version": {"const": "cpu-prefetch-stage17-phase-action-completion/2"}, "completion_id": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string", "minLength": 1}, "action_id": {"type": "string", "minLength": 1}, "authorization_sha256": {"$ref": "#/$defs/sha256"}, "request_sha256": {"$ref": "#/$defs/sha256"}, "runtime_sha256": {"$ref": "#/$defs/sha256"}, "result": {"$ref": "#/$defs/file"}, "artifact_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}}, "leader_reaped": {"const": true}, "process_group_gone": {"const": true}, "restoration_verified": {"type": "boolean"}, "quarantined": {"const": false}, "completed_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}, "phase18_authority": {"const": false}}, "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "file": {"type": "object", "additionalProperties": false, "required": ["file_name", "size_bytes", "sha256"], "properties": {"file_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}
