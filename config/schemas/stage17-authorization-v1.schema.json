{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17-authorization:v1",
  "title": "Q14 fail-closed Stage 17 authorization envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "authorization_id",
    "authorization_version",
    "phase",
    "status",
    "issued_at_utc",
    "expires_at_utc",
    "stand_id",
    "binding_id",
    "source_revision",
    "binary_sha256",
    "runner_profile_id",
    "cpu_pair_selection_id",
    "relax_mapping_id",
    "prerequisite_artifacts",
    "authorities",
    "permitted_commands",
    "limits",
    "storage_custody",
    "stop_conditions",
    "phase_inputs",
    "prohibitions",
    "detached_signature"
  ],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-authorization/1"},
    "protocol_version": {"const": "2.0.0-pre.2"},
    "authorization_id": {"$ref": "#/$defs/nonempty"},
    "authorization_version": {"$ref": "#/$defs/nonempty"},
    "phase": {
      "enum": [
        "STAND_QUALIFICATION",
        "D2_CALIBRATION",
        "SERVICE_RATE_CALIBRATION",
        "ZERO_LOSS_FEASIBILITY",
        "BLINDED_PILOT_FREEZE_INPUT"
      ]
    },
    "status": {"const": "AUTHORIZED"},
    "issued_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "stand_id": {"$ref": "#/$defs/nonempty"},
    "binding_id": {"$ref": "#/$defs/nonempty"},
    "source_revision": {"$ref": "#/$defs/nonempty"},
    "binary_sha256": {"$ref": "#/$defs/sha256"},
    "runner_profile_id": {"const": "STAGE17-STATIC-FIVE-PACKAGE-FAIL-CLOSED-v2"},
    "cpu_pair_selection_id": {"const": "XEON-CPU-FETCH-P0-NEAR-0-1-FAR-0-26-v1"},
    "relax_mapping_id": {"const": "X86-PAUSE-ONE-PER-RELAX-SITE-v1"},
    "prerequisite_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "controller", "custodian", "auditor"],
      "properties": {
        "operator": {"$ref": "#/$defs/nonempty"},
        "controller": {"$ref": "#/$defs/nonempty"},
        "custodian": {"$ref": "#/$defs/nonempty"},
        "auditor": {"$ref": "#/$defs/nonempty"}
      }
    },
    "permitted_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "executable_sha256",
          "argv",
          "privilege",
          "exact_target",
          "inverse_argv",
          "independent_readback_argv",
          "probe_argv",
          "output_artifact_id"
        ],
        "properties": {
          "command_id": {"$ref": "#/$defs/nonempty"},
          "executable_sha256": {"$ref": "#/$defs/sha256"},
          "argv": {"$ref": "#/$defs/argv"},
          "privilege": {"enum": ["NONPRIVILEGED", "PRIVILEGED"]},
          "exact_target": {"$ref": "#/$defs/nonempty"},
          "inverse_argv": {"$ref": "#/$defs/argv"},
          "independent_readback_argv": {"$ref": "#/$defs/argv"},
          "probe_argv": {"$ref": "#/$defs/argv"},
          "output_artifact_id": {"$ref": "#/$defs/nonempty"}
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_wall_seconds",
        "max_output_bytes",
        "max_artifact_count",
        "max_cpu_seconds"
      ],
      "properties": {
        "max_wall_seconds": {"$ref": "#/$defs/positive_u64"},
        "max_output_bytes": {"$ref": "#/$defs/positive_u64"},
        "max_artifact_count": {"$ref": "#/$defs/positive_u64"},
        "max_cpu_seconds": {"$ref": "#/$defs/positive_u64"}
      }
    },
    "storage_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_domain_id",
        "secondary_domain_id",
        "output_root",
        "append_only_policy_id",
        "transfer_policy_id",
        "partial_artifact_policy_id"
      ],
      "properties": {
        "primary_domain_id": {"$ref": "#/$defs/nonempty"},
        "secondary_domain_id": {"$ref": "#/$defs/nonempty"},
        "output_root": {"$ref": "#/$defs/nonempty"},
        "append_only_policy_id": {"$ref": "#/$defs/nonempty"},
        "transfer_policy_id": {"$ref": "#/$defs/nonempty"},
        "partial_artifact_policy_id": {"$ref": "#/$defs/nonempty"}
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonempty"}
    },
    "phase_inputs": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/execution_inputs"}
      ]
    },
    "prohibitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmatory_execution",
        "later_phase_execution",
        "outcome_driven_tuning",
        "top_up",
        "cell_repair",
        "hidden_retry",
        "unlisted_privilege"
      ],
      "properties": {
        "confirmatory_execution": {"const": false},
        "later_phase_execution": {"const": false},
        "outcome_driven_tuning": {"const": false},
        "top_up": {"const": false},
        "cell_repair": {"const": false},
        "hidden_retry": {"const": false},
        "unlisted_privilege": {"const": false}
      }
    },
    "detached_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "signer_id", "artifact_id", "sha256"],
      "properties": {
        "scheme": {"$ref": "#/$defs/nonempty"},
        "signer_id": {"$ref": "#/$defs/nonempty"},
        "artifact_id": {"$ref": "#/$defs/nonempty"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "STAND_QUALIFICATION"}}},
      "then": {"properties": {"phase_inputs": {"type": "null"}}},
      "else": {"properties": {"phase_inputs": {"$ref": "#/$defs/execution_inputs"}}}
    }
  ],
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positive_u64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/nonempty"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification_artifact",
        "run_plan",
        "configurations",
        "schedules",
        "namespaces",
        "seeds",
        "predecessor_artifacts",
        "permitted_run_ids",
        "permitted_run_count",
        "hardware_states"
      ],
      "properties": {
        "qualification_artifact": {"$ref": "#/$defs/artifact"},
        "run_plan": {"$ref": "#/$defs/artifact"},
        "configurations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "schedules": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "namespaces": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "seeds": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "predecessor_artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact"}
        },
        "permitted_run_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "permitted_run_count": {"$ref": "#/$defs/positive_u64"},
        "hardware_states": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["H0", "H1"]}
        }
      }
    }
  }
}
