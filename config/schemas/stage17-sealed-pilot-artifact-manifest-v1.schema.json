{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:cpu-prefetch:stage17:sealed-pilot-manifest:v1",
  "type": "object", "additionalProperties": false,
  "required": ["sealed", "checksums_verified", "run_ids", "artifact_bindings", "completion_sha256", "sealed_at_utc", "stage18_authority"],
  "properties": {
    "sealed": {"const": true}, "checksums_verified": {"const": true},
    "run_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "artifact_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "size_bytes", "sha256"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"pattern": "^[0-9a-f]{64}$"}}}},
    "completion_sha256": {"pattern": "^[0-9a-f]{64}$"}, "sealed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}, "stage18_authority": {"const": false}
  }
}
