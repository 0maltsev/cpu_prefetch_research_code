{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:cpu-prefetch:stage17:operational-typed-record:v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_id", "record_role", "subject_id", "source_bindings", "measurements", "outcome", "recorded_at_utc", "synthetic_test_only", "phase18_authority"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-operational-typed-record/2"}, "record_id": {"type": "string", "minLength": 1}, "record_role": {"type": "string", "minLength": 1}, "subject_id": {"type": "string", "minLength": 1},
    "source_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/binding"}}, "measurements": {"type": "object", "minProperties": 1}, "outcome": {"enum": ["COMPLETE", "ACCEPTED", "VERIFIED", "FROZEN"]}, "recorded_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}, "synthetic_test_only": {"type": "boolean"}, "phase18_authority": {"const": false}
  }, "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "binding": {"type": "object", "additionalProperties": false, "required": ["id", "size_bytes", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}}}
}
