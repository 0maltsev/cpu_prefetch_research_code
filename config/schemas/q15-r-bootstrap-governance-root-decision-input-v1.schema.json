{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:q15-r-bootstrap-governance-root-decision-input:v1",
  "title": "Bootstrap governance-root decision/input bundle without action authority",
