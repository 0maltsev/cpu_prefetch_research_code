{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:operational-input-manifest:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "input_id", "protocol_version", "created_at_utc", "synthetic_test_only", "predecessor_resolutions", "artifacts", "payload", "authority_expansion", "phase18_authority"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-operational-input-manifest/1"},
    "manifest_id": {"type": "string", "minLength": 1},
    "input_id": {"enum": ["S17-EXT-002", "S17-EXT-003", "S17-EXT-004", "S17-EXT-005", "S17-EXT-007", "S17-EXT-008", "S17-EXT-009", "S17-EXT-010"]},
    "protocol_version": {"const": "2.0.0-pre.2"},
    "created_at_utc": {"$ref": "#/$defs/utc"},
    "synthetic_test_only": {"type": "boolean"},
    "predecessor_resolutions": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/resolution_binding"}
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/artifact_binding"}
    },
    "payload": {"type": "object"},
    "authority_expansion": {"const": false},
    "phase18_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "resolution_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["input_id", "resolution_id", "sha256"],
      "properties": {
        "input_id": {"pattern": "^S17-EXT-[0-9]{3}$"},
        "resolution_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "artifact_id", "locator", "size_bytes", "sha256", "media_type", "schema_identity"],
      "properties": {
        "role": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
        "artifact_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"enum": ["application/json", "application/octet-stream", "text/plain"]},
        "schema_identity": {"type": ["string", "null"]}
      }
    }
  }
}
