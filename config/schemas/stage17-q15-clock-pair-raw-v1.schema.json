{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17-q15-clock-pair-raw:v1",
  "title": "Q15 clock-pair raw per-core/cross-core measurement, pre-qualification-envelope (partial)",
  "description": "cpu_prefetch_q15_clock_qualification_tool --qualify-pair's real per-core and cross-core evidence. Deliberately excludes traced_call_count/traced_syscall_count/before_block_repeat: no real VDSO call/syscall tracer or post-measurement block-repeat timestamp capture exists in this codebase yet, so those SELECTED_PAIR_CLOCK envelope fields cannot be honestly derived from this artifact alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pair",
    "producer_cpu",
    "consumer_cpu",
    "producer_pinned",
    "consumer_pinned",
    "producer_prime_read_count",
    "consumer_prime_read_count",
    "producer_delta_count",
    "consumer_delta_count",
    "producer_to_consumer_window_count",
    "consumer_to_producer_window_count",
    "exchanges_per_window",
    "producer_per_core_passed",
    "consumer_per_core_passed",
    "cross_core_passed"
  ],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-q15-clock-pair-raw/1"},
    "pair": {"enum": ["near", "far"]},
    "producer_cpu": {"type": "integer", "minimum": 0},
    "consumer_cpu": {"type": "integer", "minimum": 0},
    "producer_pinned": {"type": "boolean"},
    "consumer_pinned": {"type": "boolean"},
    "producer_prime_read_count": {"type": "integer", "minimum": 0},
    "consumer_prime_read_count": {"type": "integer", "minimum": 0},
    "producer_delta_count": {"type": "integer", "minimum": 0},
    "consumer_delta_count": {"type": "integer", "minimum": 0},
    "producer_to_consumer_window_count": {"type": "integer", "minimum": 0},
    "consumer_to_producer_window_count": {"type": "integer", "minimum": 0},
    "exchanges_per_window": {"type": "integer", "minimum": 0},
    "producer_per_core_passed": {"type": "boolean"},
    "consumer_per_core_passed": {"type": "boolean"},
    "cross_core_passed": {"type": "boolean"}
  }
}
