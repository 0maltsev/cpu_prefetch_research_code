{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:preflight-no-predecessor-attestation:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attestation_id", "actor", "recorded_at_utc",
    "search_evidence", "search_scope", "declaration", "covers_incident_ids",
    "retry_allowed", "replacement_transaction_required", "stage18_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "cpu-prefetch-stage17-preflight-no-predecessor-attestation/1"
    },
    "attestation_id": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "recorded_at_utc": {"$ref": "#/$defs/actual_utc"},
    "search_evidence": {"$ref": "#/$defs/external_binding"},
    "search_scope": {
      "const": [
        "REPOSITORY_GIT_HISTORY",
        "LOCAL_FILESYSTEM_OUTSIDE_WORKING_TREE",
        "LOCAL_BUILD_AND_CI_ARTIFACT_STORAGE"
      ]
    },
    "declaration": {"const": "NO_REAL_PREDECESSOR_EVIDENCE_FOUND"},
    "covers_incident_ids": {"const": ["D-120", "D-121", "D-123"]},
    "retry_allowed": {"const": false},
    "replacement_transaction_required": {"const": false},
    "stage18_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actual_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "external_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "size_bytes", "sha256", "schema_identity"],
      "properties": {
        "locator": {"type": "string", "pattern": "^/"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_identity": {"type": "string", "minLength": 1}
      }
    }
  }
}
