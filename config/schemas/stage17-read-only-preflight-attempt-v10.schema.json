{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:read-only-preflight-attempt:v10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "authorization_id",
    "authorization_sha256",
    "resolution_id",
    "resolution_sha256",
    "transition_id",
    "transition_sha256",
    "action_plan_sha256",
    "runtime_implementation_hashes",
    "ssh_argv_sha256",
    "rendered_programs",
    "pinned_openssh_inputs",
    "openssh_consumption_capability",
    "process_supervisor_capability",
    "prospective_evaluation_at_utc",
    "actual_authority_sample_before_marker_utc",
    "monotonic_deadline_ns",
    "monotonic_authority_deadline_ns",
    "process_group_ownership",
    "attempt_number",
    "retry_allowed",
    "post_marker_authority_sample_required",
    "stage18_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "cpu-prefetch-stage17-read-only-preflight-attempt/10"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "authorization_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "resolution_id": {
      "type": "string",
      "minLength": 1
    },
    "resolution_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "transition_id": {
      "type": "string",
      "minLength": 1
    },
    "transition_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "action_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_implementation_hashes": {
      "type": "object",
      "minProperties": 23,
      "maxProperties": 23,
      "propertyNames": {
        "enum": ["collector", "collector_v1_helper", "executor", "openssh_snapshot_broker", "openssh_snapshot_broker_v1_helper", "operational_semantics", "pilot_candidate_verifier", "process_group_supervisor", "semantic_verifier", "semantic_verifier_v10_helper", "semantic_verifier_v11_helper", "semantic_verifier_v12_helper", "semantic_verifier_v13_helper", "semantic_verifier_v3_helper", "semantic_verifier_v4_helper", "semantic_verifier_v5_helper", "semantic_verifier_v6_helper", "semantic_verifier_v7_helper", "semantic_verifier_v8_helper", "state_journal", "state_journal_v10_helper", "state_journal_v11_helper", "state_journal_v1_helper"]
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "ssh_argv_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "rendered_programs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/program"
      }
    },
    "pinned_openssh_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_hosts",
        "transport_identity"
      ],
      "properties": {
        "known_hosts": {
          "$ref": "#/$defs/snapshot"
        },
        "transport_identity": {
          "$ref": "#/$defs/snapshot"
        }
      }
    },
    "openssh_consumption_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "result",
        "ssh_version",
        "ssh_sha256",
        "sshd_sha256",
        "ssh_keygen_sha256",
        "procfs_visible_parent_pid",
        "descriptor_inheritance_used",
        "source_mutation_before_consumption",
        "strict_host_key_verification",
        "public_key_authentication",
        "local_proxy_pipe_only",
        "network_used",
        "private_bytes_recorded",
        "fixture_process_quiescence",
        "report_sha256"
      ],
      "properties": {
        "mechanism": {
          "const": "LINUX_PARENT_PROCFD_OPENSSH_SUBREAPER_QUIESCENT-v2"
        },
        "result": {
          "const": "PASS"
        },
        "ssh_version": {
          "type": "string",
          "minLength": 1
        },
        "ssh_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sshd_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ssh_keygen_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "procfs_visible_parent_pid": {
          "type": "integer",
          "minimum": 1
        },
        "descriptor_inheritance_used": {
          "const": false
        },
        "source_mutation_before_consumption": {
          "const": true
        },
        "strict_host_key_verification": {
          "const": true
        },
        "public_key_authentication": {
          "const": true
        },
        "local_proxy_pipe_only": {
          "const": true
        },
        "network_used": {
          "const": false
        },
        "private_bytes_recorded": {
          "const": false
        },
        "fixture_process_quiescence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mechanism",
            "maximum_adopted_children",
            "reaped_children",
            "sigterm_sent",
            "sigkill_sent",
            "children_remaining",
            "result"
          ],
          "properties": {
            "mechanism": {
              "const": "SUBREAPER_CAPABILITY_CHILD_REAP_BARRIER-v2"
            },
            "maximum_adopted_children": {"type": "integer", "minimum": 0},
            "reaped_children": {"type": "integer", "minimum": 0},
            "sigterm_sent": {"type": "boolean"},
            "sigkill_sent": {"type": "boolean"},
            "children_remaining": {"const": 0},
            "result": {"const": "PASS"}
          }
        },
        "report_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "process_supervisor_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "namespace_local_executor_pid",
        "namespace_local_executor_pgid",
        "procfs_visible_executor_pid",
        "procfs_visible_executor_pgid",
        "pid_namespace_inode",
        "procfs_pid_namespace_inode",
        "nspid",
        "nspgid",
        "mapping_unambiguous",
        "waitid_wnowait_available",
        "subreaper_state_readable",
        "initial_subreaper_state",
        "signal_after_leader_reap_allowed",
        "result"
      ],
      "properties": {
        "mechanism": {
          "const": "LINUX_SUBREAPER_NSPID_NSPGID_HELD_LEADER-v2"
        },
        "namespace_local_executor_pid": {
          "type": "integer",
          "minimum": 1
        },
        "namespace_local_executor_pgid": {
          "type": "integer",
          "minimum": 1
        },
        "procfs_visible_executor_pid": {
          "type": "integer",
          "minimum": 1
        },
        "procfs_visible_executor_pgid": {
          "type": "integer",
          "minimum": 1
        },
        "pid_namespace_inode": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "procfs_pid_namespace_inode": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "nspid": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "nspgid": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "mapping_unambiguous": {
          "const": true
        },
        "waitid_wnowait_available": {
          "const": true
        },
        "subreaper_state_readable": {
          "const": true
        },
        "initial_subreaper_state": {
          "enum": [
            0,
            1
          ]
        },
        "signal_after_leader_reap_allowed": {
          "const": false
        },
        "result": {
          "const": "PASS"
        }
      }
    },
    "prospective_evaluation_at_utc": {
      "$ref": "#/$defs/actual_utc"
    },
    "actual_authority_sample_before_marker_utc": {
      "$ref": "#/$defs/actual_utc"
    },
    "monotonic_deadline_ns": {
      "type": "integer",
      "minimum": 1
    },
    "monotonic_authority_deadline_ns": {
      "type": "integer",
      "minimum": 1
    },
    "process_group_ownership": {
      "const": "LINUX_SUBREAPER_NSPID_NSPGID_HOLD_LEADER_QUIESCE_THEN_REAP"
    },
    "attempt_number": {
      "const": 1
    },
    "retry_allowed": {
      "const": false
    },
    "post_marker_authority_sample_required": {
      "const": true
    },
    "stage18_authority": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actual_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "observation_id",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "observation_id": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "source_size_bytes",
        "consumed_sha256",
        "snapshot_size_bytes",
        "snapshot_mechanism",
        "verified_seals",
        "procfs_visible_parent_pid",
        "procfs_process_directory_device",
        "procfs_process_directory_inode",
        "procfs_process_directory_uid",
        "credential_fd_inherited_by_child",
        "source_path_reused_after_marker",
        "private_bytes_recorded"
      ],
      "properties": {
        "role": {
          "enum": [
            "KNOWN_HOSTS",
            "TRANSPORT_IDENTITY"
          ]
        },
        "source_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "consumed_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot_mechanism": {
          "const": "LINUX_PARENT_PROCFD_OPENSSH_SUBREAPER_QUIESCENT-v2"
        },
        "verified_seals": {
          "const": [
            "F_SEAL_WRITE",
            "F_SEAL_GROW",
            "F_SEAL_SHRINK",
            "F_SEAL_SEAL"
          ]
        },
        "procfs_visible_parent_pid": {
          "type": "integer",
          "minimum": 1
        },
        "procfs_process_directory_device": {
          "type": "integer",
          "minimum": 0
        },
        "procfs_process_directory_inode": {
          "type": "integer",
          "minimum": 1
        },
        "procfs_process_directory_uid": {
          "type": "integer",
          "minimum": 0
        },
        "credential_fd_inherited_by_child": {
          "const": false
        },
        "source_path_reused_after_marker": {
          "const": false
        },
        "private_bytes_recorded": {
          "const": false
        }
      }
    }
  }
}
