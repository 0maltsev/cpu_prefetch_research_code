{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:state-transition:v1",
  "title": "Append-only Stage 17 state transition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transition_id", "sequence_number", "from_state", "to_state", "previous_transition_sha256", "actor", "timestamp_utc", "evidence_resolutions", "authorizations", "graph_sha256", "catalog_sha256", "version_hashes", "authority_scope", "automatic_transition", "retry_allowed", "stage18_authority"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-state-transition/1"},
    "transition_id": {"type": "string", "minLength": 1},
    "sequence_number": {"type": "integer", "minimum": 1},
    "from_state": {"type": "string", "minLength": 1},
    "to_state": {"type": "string", "minLength": 1},
    "previous_transition_sha256": {"$ref": "#/$defs/sha256"},
    "actor": {"type": "string", "minLength": 1},
    "timestamp_utc": {"$ref": "#/$defs/utc"},
    "evidence_resolutions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/resolution_ref"}},
    "authorizations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/authorization_ref"}},
    "graph_sha256": {"$ref": "#/$defs/sha256"},
    "catalog_sha256": {"$ref": "#/$defs/sha256"},
    "version_hashes": {"$ref": "#/$defs/version_hashes"},
    "authority_scope": {"enum": ["READ_ONLY_PREFLIGHT_STATE_ADVANCE_ONLY", "PREFLIGHT_ACCEPTANCE_STATE_ADVANCE_ONLY", "STAGE17_PHASE_AUTHORIZATION_PREPARATION_ONLY"]},
    "automatic_transition": {"const": false},
    "retry_allowed": {"const": false},
    "stage18_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "version_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_schema_sha256", "catalog_schema_sha256", "resolution_schema_sha256", "transition_schema_sha256", "journal_schema_sha256", "custody_receipt_schema_sha256", "authorization_schema_sha256"],
      "properties": {
        "graph_schema_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_schema_sha256": {"$ref": "#/$defs/sha256"},
        "resolution_schema_sha256": {"$ref": "#/$defs/sha256"},
        "transition_schema_sha256": {"$ref": "#/$defs/sha256"},
        "journal_schema_sha256": {"$ref": "#/$defs/sha256"},
        "custody_receipt_schema_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_schema_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "resolution_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "resolution_id", "sha256"],
      "properties": {
        "input_id": {"pattern": "^S17-EXT-[0-9]{3}$"},
        "resolution_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authorization_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "resolution_id", "authorization_id", "authority_scope"],
      "properties": {
        "input_id": {"enum": ["S17-EXT-001", "S17-EXT-005", "S17-EXT-010"]},
        "resolution_id": {"type": "string", "minLength": 1},
        "authorization_id": {"type": "string", "minLength": 1},
        "authority_scope": {"enum": ["READ_ONLY_PREFLIGHT", "PRIVILEGED_QUALIFICATION_CONTROL", "STAGE17_PILOT_PHASE_ONLY"]}
      }
    }
  }
}
