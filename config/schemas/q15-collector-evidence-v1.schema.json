{
  "$id": "urn:cpu-prefetch:q15-collector-evidence:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"complete": {"const": false}}},
      "then": {"properties": {"eligible": {"const": false}}}
    }
  ],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding_id": {"type": "string", "minLength": 1},
    "captured_at_utc": {"type": "string", "format": "date-time"},
    "collector_id": {
      "enum": [
        "Q15-CLOCK-COLLECTOR-v1",
        "Q15-ATOMIC-LAYOUT-COLLECTOR-v1",
        "Q15-ACTUAL-CPU-MIGRATION-COLLECTOR-v1",
        "Q15-ADDRESS-RESIDENCY-COLLECTOR-v1",
        "Q15-SOFTWARE-PREFETCH-COLLECTOR-v1",
        "Q15-MSR-PRESTATE-COLLECTOR-v1",
        "Q15-MSR-READBACK-COLLECTOR-v1"
      ]
    },
    "complete": {"type": "boolean"},
    "consumer_cpu": {"enum": [1, 26]},
    "details": {"type": "object"},
    "eligible": {"type": "boolean"},
    "evidence_kind": {
      "enum": [
        "SELECTED_PAIR_CLOCK",
        "RUNTIME_ATOMIC_LAYOUT",
        "ACTUAL_CPU_MIGRATION",
        "ADDRESS_RESIDENCY",
        "SOFTWARE_PREFETCH_MAPPING",
        "HARDWARE_PREFETCH_PRESTATE",
        "HARDWARE_PREFETCH_READBACK"
      ]
    },
    "producer_cpu": {"const": 0},
    "protocol_version": {"const": "2.0.0-pre.2"},
    "schema_version": {"const": "cpu-prefetch-q15-collector-evidence/1"},
    "source_revision": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "stand_id": {"type": "string", "minLength": 1}
  },
  "required": [
    "artifact_id", "binary_sha256", "binding_id", "captured_at_utc",
    "collector_id", "complete", "consumer_cpu", "details", "eligible",
    "evidence_kind", "producer_cpu", "protocol_version", "schema_version",
    "source_revision", "sources", "stand_id"
  ],
  "title": "Q15 versioned collector evidence",
  "type": "object"
}
