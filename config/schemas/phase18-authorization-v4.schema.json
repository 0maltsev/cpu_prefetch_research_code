{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:cpu-prefetch:phase18:authorization:v4",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "actor", "reviewer", "external_trust_anchor_sha256", "public_key_fingerprint_sha256", "stage17_completion_sha256", "readiness_sha256", "issued_at_utc", "expires_at_utc", "allowed_chronology", "authority_scope", "stage17_authority_reuse_allowed", "automatic_transition", "retry_allowed"],
  "properties": {"schema_version": {"const": "cpu-prefetch-phase18-authorization/4"}, "authorization_id": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "reviewer": {"type": "string", "minLength": 1}, "external_trust_anchor_sha256": {"$ref": "#/$defs/sha"}, "public_key_fingerprint_sha256": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"}, "stage17_completion_sha256": {"$ref": "#/$defs/sha"}, "readiness_sha256": {"$ref": "#/$defs/sha"}, "issued_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}, "expires_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}, "allowed_chronology": {"type": "array", "prefixItems": [{"const": "PLANNED"}, {"const": "COLLECTED_SEALED"}, {"const": "TRAINING_OPEN"}, {"const": "SELECTION_FROZEN"}, {"const": "VALIDATION_UNSEALED"}, {"const": "H3_EVALUATED"}, {"const": "H1H2_RELEASED"}, {"const": "ARCHIVED"}], "items": false, "minItems": 8, "maxItems": 8}, "authority_scope": {"const": "PHASE18_ACCESS_TRANSITION_ONLY"}, "stage17_authority_reuse_allowed": {"const": false}, "automatic_transition": {"const": false}, "retry_allowed": {"const": false}},
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
