{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:q15-qualification-authorization:v2",
  "title": "Fixed-controller Q15-R authorization envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "authorization_core", "authorization_core_sha256",
    "detached_signature", "independent_signature_verification"
  ],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-q15-qualification-authorization/2"},
    "authorization_core": {"$ref": "#/$defs/authorization_core"},
    "authorization_core_sha256": {"$ref": "#/$defs/sha256"},
    "detached_signature": {"$ref": "#/$defs/artifact"},
    "independent_signature_verification": {"$ref": "#/$defs/artifact"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/nonempty"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "measurement_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision", "bundle_profile", "archive_sha256",
        "runner_sha256", "runner_profile_id", "cpu_pair_selection_id",
        "relax_mapping_id", "software_prefetch_mapping_id",
        "hardware_prefetch_mapping_id"
      ],
      "properties": {
        "source_revision": {"const": "693f00b3878ed027dc09aea7916f149874fb12a1"},
        "bundle_profile": {"const": "STAGE17-PILOT-CANDIDATE-BUNDLE-v1"},
        "archive_sha256": {"const": "f94bb6922899caba24c26910bd1ba63018425d056fa5fd8282d1098415b8ace1"},
        "runner_sha256": {"const": "8bf2577750872a7595e62797e6ef278607f3bd5308820e2c21cc957ff192c2c7"},
        "runner_profile_id": {"const": "STAGE17-STATIC-FIVE-PACKAGE-FAIL-CLOSED-v3"},
        "cpu_pair_selection_id": {"const": "XEON-CPU-FETCH-P0-NEAR-0-1-FAR-0-26-v1"},
        "relax_mapping_id": {"const": "X86-PAUSE-ONE-PER-RELAX-SITE-v1"},
        "software_prefetch_mapping_id": {"const": "X86-64-PREFETCHW-PREFETCHT0-v1"},
        "hardware_prefetch_mapping_id": {"const": "INTEL-06_55H-MSR-1A4-DISABLE-0_3-v1"}
      }
    },
    "qualification_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_profile", "bundle_sha256", "source_revision", "tool_binary_sha256",
        "controller_binary_sha256", "tool_profile_id", "controller_profile_id",
        "probe_contract_sha256", "dynamic_profile_sha256",
        "controller_profile_sha256"
      ],
      "properties": {
        "bundle_profile": {"const": "Q15-QUALIFICATION-TOOL-BUNDLE-v2"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "source_revision": {"$ref": "#/$defs/nonempty"},
        "tool_binary_sha256": {"$ref": "#/$defs/sha256"},
        "controller_binary_sha256": {"$ref": "#/$defs/sha256"},
        "tool_profile_id": {"const": "Q15-FIXED-QUALIFICATION-TOOL-v1"},
        "controller_profile_id": {"const": "Q15-R-STATIC-CONTROLLER-v1"},
        "probe_contract_sha256": {"const": "c5a13646ea5e413239337e1b83b3162578c35591a54d6002f656a78acfd3d531"},
        "dynamic_profile_sha256": {"const": "b25e3f10eae82cde0084c5907982ac0ae090d8de790656627f7760b614ebe08c"},
        "controller_profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "controller", "custodian", "auditor"],
      "properties": {
        "operator": {"const": "cpu-prefetch-q15-operator"},
        "controller": {"const": "cpu-prefetch-q15-controller"},
        "custodian": {"const": "cpu-prefetch-q15-custodian"},
        "auditor": {"const": "cpu-prefetch-q15-auditor"}
      }
    },
    "controller_invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable_path", "executable_sha256", "argv"],
      "properties": {
        "executable_path": {"type": "string", "pattern": "^/[^*?]+$"},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "argv": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"type": "string", "pattern": "^/[^*?]+$"},
            {"const": "--execute-q15-r"},
            {"type": "string", "pattern": "^/[^*?]+$"},
            {"type": "string", "pattern": "^/[^*?]+$"}
          ],
          "items": false
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_validity_seconds", "max_same_buffer_session_wall_seconds",
        "max_active_collection_wall_seconds", "external_start_watchdog_seconds",
        "controller_start_poll_limit", "worker_start_poll_limit",
        "max_cpu_seconds", "max_output_bytes", "max_artifact_count",
        "frame_maximum_payload_bytes", "primary_custody_quota_bytes"
      ],
      "properties": {
        "authorization_validity_seconds": {"const": 14400},
        "max_same_buffer_session_wall_seconds": {"const": 14400},
        "max_active_collection_wall_seconds": {"const": 1800},
        "external_start_watchdog_seconds": {"const": 60},
        "controller_start_poll_limit": {"const": 18446744073709551615},
        "worker_start_poll_limit": {"const": 18446744073709551615},
        "max_cpu_seconds": {"const": 7200},
        "max_output_bytes": {"const": 2147483648},
        "max_artifact_count": {"const": 128},
        "frame_maximum_payload_bytes": {"const": 16777216},
        "primary_custody_quota_bytes": {"const": 4294967296}
      }
    },
    "storage_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_domain_id", "secondary_domain_id", "output_root",
        "append_only_policy_id", "transfer_policy_id",
        "partial_artifact_policy_id", "recovery_policy_id"
      ],
      "properties": {
        "primary_domain_id": {"const": "XEON-CPU-FETCH-MD3-Q15-CUSTODY"},
        "secondary_domain_id": {"const": "DEVELOPMENT-REPOSITORY-Q15-CUSTODY"},
        "output_root": {"const": "/var/lib/cpu-prefetch/q15-r"},
        "append_only_policy_id": {"const": "Q15-PRIMARY-APPEND-ONLY-SEAL-THEN-TRANSFER-v1"},
        "transfer_policy_id": {"const": "Q15-HASHED-SEALED-TRANSFER-WITH-RECEIPT-v1"},
        "partial_artifact_policy_id": {"const": "Q15-RETAIN-PARTIAL-NEVER-PROMOTE-v1"},
        "recovery_policy_id": {"const": "Q15-NO-OVERWRITE-NEW-ARTIFACT-ID-v1"}
      }
    },
    "phase_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_artifact", "topology_artifact", "storage_artifact",
        "access_matrix_artifact", "negative_access_evidence_artifact",
        "start_barrier_policy_artifact", "external_watchdog_policy_artifact",
        "custody_policy_artifact", "transfer_receipt_contract_artifact"
      ],
      "properties": {
        "inventory_artifact": {"$ref": "#/$defs/artifact"},
        "topology_artifact": {"$ref": "#/$defs/artifact"},
        "storage_artifact": {"$ref": "#/$defs/artifact"},
        "access_matrix_artifact": {"$ref": "#/$defs/artifact"},
        "negative_access_evidence_artifact": {"$ref": "#/$defs/artifact"},
        "start_barrier_policy_artifact": {"$ref": "#/$defs/artifact"},
        "external_watchdog_policy_artifact": {"$ref": "#/$defs/artifact"},
        "custody_policy_artifact": {"$ref": "#/$defs/artifact"},
        "transfer_receipt_contract_artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "prohibitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_execution", "calibration_execution", "pilot_execution",
        "confirmatory_execution", "scientific_schedule_access",
        "scientific_namespace_access", "outcome_access", "outcome_driven_tuning",
        "top_up", "cell_repair", "hidden_retry", "q15_w_execution",
        "unlisted_target", "unlisted_privilege"
      ],
      "properties": {
        "measurement_execution": {"const": false},
        "calibration_execution": {"const": false},
        "pilot_execution": {"const": false},
        "confirmatory_execution": {"const": false},
        "scientific_schedule_access": {"const": false},
        "scientific_namespace_access": {"const": false},
        "outcome_access": {"const": false},
        "outcome_driven_tuning": {"const": false},
        "top_up": {"const": false},
        "cell_repair": {"const": false},
        "hidden_retry": {"const": false},
        "q15_w_execution": {"const": false},
        "unlisted_target": {"const": false},
        "unlisted_privilege": {"const": false}
      }
    },
    "signature_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization", "scheme", "namespace", "signer_id",
        "signer_key_fingerprint"
      ],
      "properties": {
        "canonicalization": {"const": "JCS-I64-v1"},
        "scheme": {"const": "OPENSSH-SSHSIG-ED25519-SHA512-v1"},
        "namespace": {"const": "cpu-prefetch-q15-authorization"},
        "signer_id": {"$ref": "#/$defs/nonempty"},
        "signer_key_fingerprint": {
          "type": "string",
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
        }
      }
    },
    "authorization_core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version", "authorization_id", "authorization_version",
        "phase", "status", "issued_at_utc", "expires_at_utc", "stand_id",
        "binding_id", "measurement_candidate", "qualification_release",
        "authorities", "controller_invocation", "command_graph",
        "prerequisite_artifacts", "limits", "storage_custody", "phase_inputs",
        "stop_conditions", "prohibitions", "signature_policy"
      ],
      "properties": {
        "protocol_version": {"const": "2.0.0-pre.2"},
        "authorization_id": {"$ref": "#/$defs/nonempty"},
        "authorization_version": {"$ref": "#/$defs/nonempty"},
        "phase": {"const": "Q15_R_READ_ONLY"},
        "status": {"const": "AUTHORIZED"},
        "issued_at_utc": {"type": "string", "format": "date-time"},
        "expires_at_utc": {"type": "string", "format": "date-time"},
        "stand_id": {"const": "XEON-CPU-FETCH"},
        "binding_id": {"$ref": "#/$defs/nonempty"},
        "measurement_candidate": {"$ref": "#/$defs/measurement_candidate"},
        "qualification_release": {"$ref": "#/$defs/qualification_release"},
        "authorities": {"$ref": "#/$defs/authorities"},
        "controller_invocation": {"$ref": "#/$defs/controller_invocation"},
        "command_graph": {
          "const": [
            "VERIFY_AUTHORIZATION_AND_RELEASE_BINDINGS",
            "VERIFY_ROLE_AND_NEGATIVE_ACCESS_EVIDENCE",
            "CREATE_PRIVATE_SAME_BUFFER_SESSION",
            "COLLECT_FIXED_MSR_PRESTATE_AS_AUDITOR",
            "COLLECT_CLOCK",
            "COLLECT_ATOMIC_LAYOUT",
            "COLLECT_ACTUAL_CPU_MIGRATION",
            "COLLECT_ADDRESS_RESIDENCY",
            "COLLECT_SOFTWARE_PREFETCH_CAPABILITY",
            "COLLECT_STORAGE_CUSTODY",
            "NEGATIVE_ACCESS_CHECK",
            "RUN_H0_REGULAR_STREAM_PROBE",
            "RUN_H0_POINTER_STREAM_PROBE",
            "SEAL_Q15_R_EVIDENCE",
            "WAIT_FOR_SEPARATE_Q15_W_OR_EXPIRE_FAIL_CLOSED"
          ]
        },
        "prerequisite_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "limits": {"$ref": "#/$defs/limits"},
        "storage_custody": {"$ref": "#/$defs/storage_custody"},
        "phase_inputs": {"$ref": "#/$defs/phase_inputs"},
        "stop_conditions": {
          "const": [
            "FIRST_AUTHORIZATION_OR_RELEASE_BINDING_MISMATCH",
            "FIRST_ROLE_OR_NEGATIVE_ACCESS_MISMATCH",
            "FIRST_PEER_CREDENTIAL_OR_TRANSPORT_MISMATCH",
            "FIRST_CLOCK_AFFINITY_NUMA_RESIDENCY_FAULT_PMU_OR_MSR_FAILURE",
            "FIRST_INTEGRITY_COUNT_CANONICALIZATION_HASH_OR_CUSTODY_FAILURE",
            "FIRST_LIMIT_EXPIRY_OR_DISCONNECT",
            "PRESERVE_PARTIAL_EVIDENCE_AND_NEVER_RETRY"
          ]
        },
        "prohibitions": {"$ref": "#/$defs/prohibitions"},
        "signature_policy": {"$ref": "#/$defs/signature_policy"}
      }
    }
  }
}
