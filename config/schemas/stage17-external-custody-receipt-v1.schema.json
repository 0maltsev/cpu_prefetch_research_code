{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:external-custody-receipt:v1",
  "title": "Stage 17 external custody and integration receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "artifact_locator", "artifact_size_bytes", "artifact_sha256", "sidecars", "custody_domain_id", "verifier_id", "verifier_version", "verification_result", "verified_at_utc", "contract_path", "contract_sha256"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-external-custody-receipt/1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "artifact_locator": {"type": "string", "pattern": "^/"},
    "artifact_size_bytes": {"type": "integer", "minimum": 0},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "sidecars": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sidecar"}},
    "custody_domain_id": {"type": "string", "minLength": 1},
    "verifier_id": {"type": "string", "minLength": 1},
    "verifier_version": {"type": "string", "minLength": 1},
    "verification_result": {"const": "PASS"},
    "verified_at_utc": {"$ref": "#/$defs/utc"},
    "contract_path": {"type": "string", "minLength": 1},
    "contract_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "sidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "size_bytes", "sha256"],
      "properties": {
        "locator": {"type": "string", "pattern": "^/"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
