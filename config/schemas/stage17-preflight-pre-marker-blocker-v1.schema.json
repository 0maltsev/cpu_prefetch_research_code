{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:preflight-pre-marker-blocker:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "blocker_id", "recorded_at_utc", "source_transaction_id", "source_revision", "source_journal", "source_authorization", "source_preflight_output_root", "failure_stage", "failure_category", "schema_expected_runtime_identities", "actual_policy_runtime_identities", "attempt_marker_absent", "transport_started", "stand_observations_started", "retry_performed", "successor_authority", "stage18_authority"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-preflight-pre-marker-blocker/1"},
    "blocker_id": {"type": "string", "minLength": 1},
    "recorded_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "source_transaction_id": {"type": "string", "minLength": 1},
    "source_revision": {"const": "41802850ce405b3a8324b4efc4d058f1fc33afa2"},
    "source_journal": {"$ref": "#/$defs/external_binding"},
    "source_authorization": {"$ref": "#/$defs/external_binding"},
    "source_preflight_output_root": {"type": "string", "pattern": "^/"},
    "failure_stage": {"const": "PRE_MARKER_SCHEMA_VALIDATION"},
    "failure_category": {"const": "RUNTIME_IMPLEMENTATION_HASH_CARDINALITY_MISMATCH"},
    "schema_expected_runtime_identities": {"const": 17},
    "actual_policy_runtime_identities": {"const": 19},
    "attempt_marker_absent": {"const": true},
    "transport_started": {"const": false},
    "stand_observations_started": {"const": false},
    "retry_performed": {"const": false},
    "successor_authority": {"const": false},
    "stage18_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "external_binding": {"type": "object", "additionalProperties": false, "required": ["locator", "size_bytes", "sha256"], "properties": {"locator": {"type": "string", "pattern": "^/"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
