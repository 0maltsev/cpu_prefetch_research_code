{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:q15-r-stand-prestate-collector-contract:v1",
  "title": "Accepted no-authority Q15-R stand-prestate collector contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "protocol_version", "stand_id", "status", "canonicalization", "artifact_hash_profile", "execution_contract", "commands", "artifact_contract", "authority_boundary"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-q15-r-stand-prestate-collector-contract/1"},
    "contract_id": {"const": "Q15-R-STAND-PRESTATE-COLLECTOR-CONTRACT-v1"},
    "protocol_version": {"const": "2.0.0-pre.2"},
    "stand_id": {"const": "XEON-CPU-FETCH"},
    "status": {"const": "ACCEPTED_IMPLEMENTED_REPOSITORY_LOCAL_NO_EXECUTION_AUTHORITY"},
    "canonicalization": {"const": "JCS-I64-v1"},
    "artifact_hash_profile": {"const": "Q15-R-PRESTATE-JCS-I64-ZEROSELF-SHA256-v1"},
    "execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_order", "argv_policy", "fixed_environment", "maximum_command_count", "maximum_stdout_bytes_per_command", "maximum_stderr_bytes_per_command", "maximum_total_captured_bytes", "maximum_artifact_bytes", "per_command_timeout_seconds", "external_total_watchdog_seconds", "retry_count", "continue_after_failure", "partial_artifact_required"],
      "properties": {
        "command_order": {"const": "P4R_COMMAND_ID_ASCENDING_STOP_FIRST_FAILURE"},
        "argv_policy": {"const": "EXACT_ABSOLUTE_ARGV_NO_SHELL_NO_GLOB_NO_INHERITED_ENV-v1"},
        "fixed_environment": {"const": ["LANG=C", "LC_ALL=C", "TZ=UTC0"]},
        "maximum_command_count": {"const": 25},
        "maximum_stdout_bytes_per_command": {"const": 1048576},
        "maximum_stderr_bytes_per_command": {"const": 1048576},
        "maximum_total_captured_bytes": {"const": 16777216},
        "maximum_artifact_bytes": {"const": 67108864},
        "per_command_timeout_seconds": {"const": 30},
        "external_total_watchdog_seconds": {"const": 900},
        "retry_count": {"const": 0},
        "continue_after_failure": {"const": false},
        "partial_artifact_required": {"const": true}
      }
    },
    "commands": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "observation_kind", "argv", "accepted_exit_codes"],
        "properties": {
          "id": {"pattern": "^P4R-0(0[1-9]|1[0-9]|2[0-5])$"},
          "observation_kind": {"pattern": "^[A-Z][A-Z0-9_]+$"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "accepted_exit_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 255}}
        }
      }
    },
    "artifact_contract": {"type": "object"},
    "authority_boundary": {"type": "object"}
  }
}
