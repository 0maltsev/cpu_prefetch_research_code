{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:cpu-prefetch:stage17:operational-input-manifest:v3",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "input_id", "stand_id", "predecessor_resolutions", "artifacts", "synthetic_test_only", "phase18_authority"],
  "properties": {"schema_version": {"const": "cpu-prefetch-stage17-operational-input-manifest/3"}, "manifest_id": {"type": "string", "minLength": 1}, "input_id": {"enum": ["S17-EXT-002", "S17-EXT-003", "S17-EXT-004", "S17-EXT-005", "S17-EXT-007", "S17-EXT-008", "S17-EXT-009", "S17-EXT-010"]}, "stand_id": {"type": "string", "minLength": 1}, "predecessor_resolutions": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["input_id", "resolution_id", "sha256"], "properties": {"input_id": {"pattern": "^S17-EXT-[0-9]{3}$"}, "resolution_id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}, "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "stage17-operational-artifact-v3.schema.json"}}, "synthetic_test_only": {"type": "boolean"}, "phase18_authority": {"const": false}}
}
