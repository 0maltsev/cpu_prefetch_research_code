{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:cpu-prefetch:stage17:runtime-release-provenance:v3",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "bundle_root", "bundle_profile", "source_revision", "bundle_manifest", "sha256s", "sbom", "inventory", "worker", "full_bundle_verifier", "synthetic_test_only", "phase18_authority"],
  "properties": {"schema_version": {"const": "cpu-prefetch-stage17-runtime-release-provenance/3"}, "receipt_id": {"type": "string", "minLength": 1}, "bundle_root": {"type": "string", "pattern": "^/"}, "bundle_profile": {"enum": ["STAGE17-PILOT-CANDIDATE-BUNDLE-v3", "STAGE17-HERMETIC-DRY-RUN-BUNDLE-v1"]}, "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "bundle_manifest": {"$ref": "#/$defs/file"}, "sha256s": {"$ref": "#/$defs/file"}, "sbom": {"$ref": "#/$defs/file"}, "inventory": {"$ref": "#/$defs/file"}, "worker": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256", "role", "runtime_profile", "supported_actions"], "properties": {"path": {"const": "release/bin/cpu_prefetch_runner"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "role": {"const": "STAGE17_FIXED_ACTION_WORKER"}, "runtime_profile": {"const": "STAGE17-FIXED-ACTION-WORKER-v3"}, "supported_actions": {"type": "array", "prefixItems": [{"const": "Q15-R"}, {"const": "Q15-W"}, {"const": "Q16a"}, {"const": "Q16b"}, {"const": "Q16c"}, {"const": "STAGE17-BLINDED-PILOT"}], "items": false, "minItems": 6, "maxItems": 6}}}, "full_bundle_verifier": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256", "result"], "properties": {"path": {"const": "validators/verify_stand_bundle.py"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "result": {"const": "PASS"}}}, "synthetic_test_only": {"type": "boolean"}, "phase18_authority": {"const": false}},
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "file": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}
}
