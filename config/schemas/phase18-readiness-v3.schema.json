{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:cpu-prefetch:phase18:readiness:v3",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "readiness_id", "stage17_completion_sha256", "trust_enrollment_sha256", "state", "authorization_issued", "phase18_authority"],
  "properties": {"schema_version": {"const": "cpu-prefetch-phase18-readiness/3"}, "readiness_id": {"type": "string", "minLength": 1}, "stage17_completion_sha256": {"$ref": "#/$defs/sha"}, "trust_enrollment_sha256": {"$ref": "#/$defs/sha"}, "state": {"const": "READY_FOR_SEPARATE_PHASE18_AUTHORIZATION"}, "authorization_issued": {"const": false}, "phase18_authority": {"const": false}},
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
