      "gate_id": {"const": "Q15-R-P4-K-R"}, "purpose": {"const": "INDEPENDENT_READ_ONLY_PUBLIC_KEY_ALLOWED_SIGNERS_CUSTODY_AND_LINEAGE_REVIEW"},
      "source_mode": {"const": "NEW_OFFLINE_ED25519_KEY_CEREMONY_UNDER_LATER_SEPARATE_EXACT_AUTHORIZATION"},
      "custody_domain_id": {"const": "OWNER-OFFLINE-Q15-KEY-CUSTODY"}, "custodian_principal_id": {"const": "cpu-prefetch-q15-custodian"},
      "named_authority_principal": {"const": "cpu-prefetch-q15-operator"}, "independent_review_principal": {"const": "cpu-prefetch-q15-auditor"},
      "required_complete_p4_k_a_receipt_sha256": {"type": "null"}, "authorization_id": {"type": "null"}, "authorization_sha256": {"type": "null"}, "issued_at_utc": {"type": "null"}, "expires_at_utc": {"type": "null"},
      "exact_validity_seconds": {"const": 1800}, "renewal_allowed": {"const": false}, "reuse_allowed": {"const": false},
      "canonicalization": {"const": "JCS-I64-v1"}, "signature_scheme": {"const": "OPENSSH-SSHSIG-ED25519-SHA512-v1"}, "signature_principal": {"const": "cpu-prefetch-q15-authorization"}, "signature_namespace": {"const": "cpu-prefetch-q15-authorization"},
      "bootstrap_authorization_signer_fingerprint": {"type": "null"}, "bootstrap_authorization_trust_evidence_sha256": {"type": "null"}, "detached_signature_sha256": {"type": "null"}, "pre_execution_independent_review_sha256": {"type": "null"}
    }},
    "fixed_review_contract": {"const": {
      "reviewer_must_differ_from_authority_and_custodian": true,
