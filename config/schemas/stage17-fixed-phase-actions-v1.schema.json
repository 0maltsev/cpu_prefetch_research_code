{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:fixed-phase-actions:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "profile_id", "protocol_version", "actions", "execution_policy", "phase18_authority"],
