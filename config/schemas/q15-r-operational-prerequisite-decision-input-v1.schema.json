{
  "$defs": {
    "argv": {
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "type": "array"
    },
    "decision": {
      "additionalProperties": false,
      "properties": {
        "classification": {"type": "string", "minLength": 1},
        "compatibility_effect": {"type": "string", "minLength": 1},
        "deadline_gate": {"type": "string", "minLength": 1},
        "decision_id": {"enum": ["D-061", "D-062", "D-063", "D-064"]},
        "evidence": {"items": {"type": "string", "minLength": 1}, "minItems": 1, "type": "array"},
        "options_considered": {"items": {"type": "string", "minLength": 1}, "minItems": 2, "type": "array"},
        "owner": {"items": {"type": "string", "minLength": 1}, "minItems": 1, "type": "array"},
        "recommended_option": {"type": "string", "minLength": 1},
        "scientific_effect": {"type": "string", "minLength": 1},
        "selected_option": {"type": "null"},
        "state": {"const": "PROPOSED_AWAITING_EXPLICIT_APPROVAL"},
        "supersession_rule": {"type": "string", "minLength": 1}
      },
      "required": [
        "classification",
        "compatibility_effect",
        "deadline_gate",
        "decision_id",
        "evidence",
        "options_considered",
        "owner",
        "recommended_option",
        "scientific_effect",
        "selected_option",
        "state",
        "supersession_rule"
      ],
      "type": "object"
    },
    "hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "probe": {
      "additionalProperties": false,
      "properties": {
        "argv": {"$ref": "#/$defs/argv"},
        "expected": {"enum": ["ALLOW", "DENY"]},
        "id": {"pattern": "^NA-[0-9]{3}$", "type": "string"},
        "principal": {
          "enum": [
            "cpu-prefetch-q15-operator",
            "cpu-prefetch-q15-controller",
            "cpu-prefetch-q15-custodian",
            "cpu-prefetch-q15-auditor"
          ]
        }
      },
      "required": ["argv", "expected", "id", "principal"],
      "type": "object"
    },
    "rollback_command": {
      "additionalProperties": false,
      "properties": {
        "argv": {"$ref": "#/$defs/argv"},
        "executed": {"const": false},
        "id": {"pattern": "^RB-[0-9]{3}$", "type": "string"}
      },
      "required": ["argv", "executed", "id"],
      "type": "object"
    },
    "setup_command": {
      "additionalProperties": false,
      "properties": {
        "argv": {"$ref": "#/$defs/argv"},
        "executed": {"const": false},
        "expected_exit_codes": {"items": {"minimum": 0, "type": "integer"}, "minItems": 1, "type": "array", "uniqueItems": true},
        "id": {"pattern": "^SETUP-[0-9]{3}$", "type": "string"},
        "mutation": {"type": "boolean"},
        "phase": {"enum": ["PRESTATE", "APPLY"]}
      },
      "required": ["argv", "executed", "expected_exit_codes", "id", "mutation", "phase"],
      "type": "object"
    }
  },
  "$id": "urn:cpu-prefetch:q15-r-operational-prerequisite-decision-input:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
