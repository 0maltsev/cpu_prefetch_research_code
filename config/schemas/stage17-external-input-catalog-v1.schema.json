{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:external-input-catalog:v1",
  "title": "Immutable Stage 17 external-input requirement catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "protocol_version", "items", "fixed_evidence_contracts", "completion_rule", "confirmatory_boundary", "legacy_checklist_v1_sha256"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-external-input-catalog/1"},
    "catalog_id": {"const": "STAGE17-EXTERNAL-INPUT-CATALOG-v1"},
    "protocol_version": {"const": "2.0.0-pre.2"},
    "items": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/item"}},
    "fixed_evidence_contracts": {
      "const": [
        {
          "input_id": "S17-EXT-006",
          "path": "config/stage17/stage17-pilot-candidate-external-contract-v1.json",
          "size_bytes": 1899,
          "sha256": "256675098d20881861f5593fc58e1b78a40326366bd1f279be79ef30ead66ded",
          "schema_path": "config/schemas/stage17-pilot-candidate-external-contract-v1.schema.json",
          "schema_sha256": "31b92e0e1d1f8aafa2c7be4af74942042f2b1be244b57845288e9f64ccf75a74",
          "verifier_id": "STAGE17-PILOT-CANDIDATE-EXTERNAL-VERIFIER",
          "verifier_version": "1",
          "verifier_path": "tools/stage17_pilot_candidate_artifact.py",
          "verifier_sha256": "d25d7340891987bfb2c5db652f8f279ca30d7f5c65452d53e1dc05f0b11ff8a1"
        }
      ]
    },
    "completion_rule": {"const": "EVERY_INPUT_HAS_ONE_VERIFIED_APPEND_ONLY_RESOLUTION_RECORD"},
    "confirmatory_boundary": {"const": "NO_RESOLUTION_OR_TRANSITION_AUTHORIZES_STAGE18_OR_UNSEALS_CONFIRMATORY_OUTCOMES"},
    "legacy_checklist_v1_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "gate", "description", "required_evidence", "owner", "resolution_rule", "evidence_policy", "authorization_required", "not_applicable_allowed"],
      "properties": {
        "input_id": {"pattern": "^S17-EXT-[0-9]{3}$"},
        "gate": {"enum": ["AUTHORIZED_FOR_READ_ONLY_PREFLIGHT", "PREFLIGHT_ACCEPTED", "READY_FOR_STAGE17_PHASE_AUTHORIZATION", "READY_FOR_STAGE17_PILOT_EXECUTION"]},
        "description": {"type": "string", "minLength": 1},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "owner": {"type": "string", "minLength": 1},
        "resolution_rule": {"type": "string", "minLength": 1},
        "evidence_policy": {"enum": ["REPOSITORY_FILE", "EXTERNAL_CUSTODY_RECEIPT", "MIXED"]},
        "authorization_required": {"type": "boolean"},
        "not_applicable_allowed": {"const": false}
      }
    }
  }
}
