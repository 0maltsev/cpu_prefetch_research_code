{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:read-only-preflight-authorization:v2",
  "title": "Stage 17 S17-EXT-001 read-only preflight authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "input_id", "actor", "issued_at_utc", "expires_at_utc", "authority_scope", "target_scope", "target", "frozen_observation_ids", "supporting_observation_contract", "limits", "role_collapse_acknowledged", "independent_review_claimed", "permissions"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-read-only-preflight-authorization/2"},
    "authorization_id": {"type": "string", "minLength": 1},
    "input_id": {"const": "S17-EXT-001"},
    "actor": {"type": "string", "minLength": 1},
    "issued_at_utc": {"$ref": "#/$defs/utc"},
    "expires_at_utc": {"$ref": "#/$defs/utc"},
    "authority_scope": {"const": "READ_ONLY_PREFLIGHT"},
    "target_scope": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stand_id", "ssh_target", "pinned_host_key_evidence_sha256"],
      "properties": {
        "stand_id": {"type": "string", "minLength": 1},
        "ssh_target": {"type": "string", "minLength": 1},
        "pinned_host_key_evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "frozen_observation_ids": {
      "const": [
        "S17-RO-PREFLIGHT-001-TARGET-AND-TRANSPORT-IDENTITY",
        "S17-RO-PREFLIGHT-002-ARCHIVE-AND-SIDECAR-BYTE-VERIFICATION",
        "S17-RO-PREFLIGHT-003-BUNDLE-INTERNAL-VERIFICATION",
        "S17-RO-PREFLIGHT-004-NONPRIVILEGED-SELF-TESTS",
        "S17-RO-PREFLIGHT-005-RUNTIME-TOOL-IDENTITIES",
        "S17-RO-PREFLIGHT-006-READ-ONLY-PLATFORM-INVENTORY"
      ]
    },
    "supporting_observation_contract": {"$ref": "#/$defs/typed_file_binding"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_commands", "max_wall_seconds", "max_total_output_bytes", "attempts_per_observation", "retries"],
      "properties": {
        "max_commands": {"const": 6},
        "max_wall_seconds": {"type": "integer", "minimum": 1},
        "max_total_output_bytes": {"type": "integer", "minimum": 1},
        "attempts_per_observation": {"const": 1},
        "retries": {"const": 0}
      }
    },
    "role_collapse_acknowledged": {"const": true},
    "independent_review_claimed": {"const": false},
    "permissions": {
      "const": {
        "stand_read_only": true,
        "stand_mutation": false,
        "privileged_controls": false,
        "qualification": false,
        "calibration": false,
        "pilot_execution": false,
        "measurement": false,
        "stage18_authority": false
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "typed_file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256", "schema_identity"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_identity": {"const": "cpu-prefetch-stage17-read-only-preflight-supporting-contract/2"}
      }
    }
  }
}
