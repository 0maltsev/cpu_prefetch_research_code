{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:cpu-prefetch:stage17:run-output:v3",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "plan_sha256", "schedule_sha256", "seed_id", "runner_admission_sha256", "package", "cell_ordinal", "repetition_ordinal", "hardware_state", "placement", "working_set_class", "load_level", "planned_attempt_capacity", "offered_count", "accepted_count", "full_count", "consumed_count", "final_consumer_checksum", "zero_loss", "join_status", "warmup_reset_verified", "treatment_blind", "confirmatory_outcomes_accessed", "complete"],
  "properties": {"schema_version": {"enum": ["cpu-prefetch-stage17-q16b-output/3", "cpu-prefetch-stage17-q16c-output/3", "cpu-prefetch-stage17-blinded-pilot-run/3"]}, "run_id": {"type": "string", "minLength": 1}, "plan_sha256": {"$ref": "#/$defs/sha256"}, "schedule_sha256": {"$ref": "#/$defs/sha256"}, "seed_id": {"type": "string", "minLength": 1}, "runner_admission_sha256": {"$ref": "#/$defs/sha256"}, "package": {"enum": ["R0", "R1", "R2", "L0", "L1"]}, "cell_ordinal": {"type": ["integer", "null"], "minimum": 0, "maximum": 179}, "repetition_ordinal": {"type": ["integer", "null"], "minimum": 0}, "hardware_state": {"enum": ["H0", "H1", null]}, "placement": {"enum": ["NEAR", "FAR", null]}, "working_set_class": {"enum": ["L2_RESIDENT", "LLC_RESIDENT", "BEYOND_LLC", null]}, "load_level": {"enum": ["L025", "L050", "L075", null]}, "planned_attempt_capacity": {"type": "integer", "minimum": 1}, "offered_count": {"type": "integer", "minimum": 1}, "accepted_count": {"type": "integer", "minimum": 0}, "full_count": {"type": "integer", "minimum": 0}, "consumed_count": {"type": "integer", "minimum": 0}, "final_consumer_checksum": {"type": "integer", "minimum": 0}, "zero_loss": {"type": "boolean"}, "join_status": {"const": "PASSED"}, "warmup_reset_verified": {"type": "boolean"}, "treatment_blind": {"const": true}, "confirmatory_outcomes_accessed": {"const": false}, "complete": {"const": true}},
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
