    "ordinal": {"type": "integer", "minimum": 1, "maximum": 6}, "observation_id": {"type": "string"}, "rendered_program_sha256": {"$ref": "#/$defs/sha256"}, "ssh_argv_sha256": {"$ref": "#/$defs/sha256"},
    "actual_authority_sample_before_marker_utc": {"$ref": "#/$defs/actual_utc"}, "actual_authority_sample_before_first_transport_utc": {"$ref": "#/$defs/actual_utc"}, "actual_started_at_utc": {"$ref": "#/$defs/actual_utc"}, "actual_completed_at_utc": {"$ref": "#/$defs/actual_utc"}, "duration_ns": {"type": "integer", "minimum": 0},
