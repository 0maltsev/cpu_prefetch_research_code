      "bootstrap_blocking_adr_path": {"const": "docs/decisions/0083-q15-r-p4-k-a-bootstrap-governance-root.md"},
      "bootstrap_blocking_adr_sha256": {"const": "fd608cabbf9a9bf01cc70c6f991a2c19564548ddf2baa45d017b31f7a505cfe5"},
      "generic_controller_profile_path": {"const": "config/q15/q15-r-p4-k-a-controller-profile-v1.json"},
      "generic_controller_profile_sha256": {"const": "0ceafd80200ba62584532e035a4c2a21015c2b56f75d0ebbfdffbd7f3b945875"}
    }},
    "decisions": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["decision_id", "classification", "subject", "options_considered", "recommended_option", "selected_option", "state", "scientific_effect", "compatibility_effect", "owner", "deadline_gate", "supersession_rule"], "properties": {
      "decision_id": {"pattern": "^D-09[0-2]$|^D-08[7-9]$"},
      "classification": {"type": "string", "minLength": 1},
      "subject": {"type": "string", "minLength": 1},
      "options_considered": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "recommended_option": {"type": "string", "minLength": 1},
      "selected_option": {"type": "null"},
      "state": {"pattern": "^UNRESOLVED_[A-Z_]+$"},
      "scientific_effect": {"const": "none"},
      "compatibility_effect": {"type": "string", "minLength": 1},
      "owner": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "deadline_gate": {"type": "string", "minLength": 1},
      "supersession_rule": {"type": "string", "minLength": 1}
    }}},
    "external_inputs": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": {"name": {"type": "string", "minLength": 1}, "value": {"type": "null"}}}},
    "owner_questions": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["question_id", "decision_id", "answer"], "properties": {"question_id": {"pattern": "^BGR-Q[1-6]$"}, "decision_id": {"pattern": "^D-09[0-2]$|^D-08[7-9]$"}, "answer": {"type": "null"}}}},
