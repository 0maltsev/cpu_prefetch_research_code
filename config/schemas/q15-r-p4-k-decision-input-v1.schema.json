{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:q15-r-p4-k-decision-input:v1",
  "title": "Q15-R-P4-K owner decision and external-input bundle without key authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "protocol_version",
    "stand_id",
    "status",
    "lineage",
    "decisions",
    "owner_input_contract",
    "fixed_accepted_policy",
    "proposed_gate_graph",
    "minimum_owner_inputs_before_exact_acceptance",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-q15-r-p4-k-decision-input/1"},
    "bundle_id": {"const": "Q15-R-P4-K-DECISION-INPUT-20260825-01"},
    "protocol_version": {"const": "2.0.0-pre.2"},
    "stand_id": {"const": "XEON-CPU-FETCH"},
    "status": {"const": "PROPOSED_OWNER_SELECTION_AND_EXTERNAL_INPUTS_REQUIRED_NO_KEY_OR_EXECUTION_AUTHORITY"},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p4_k_preparation_path",
        "p4_k_preparation_sha256",
        "p4_d_acceptance_path",
        "p4_d_acceptance_sha256",
        "p4_f_acceptance_path",
        "p4_f_acceptance_sha256",
        "adr_0066_path",
        "adr_0066_sha256",
        "adr_0070_path",
        "adr_0070_sha256"
      ],
      "properties": {
        "p4_k_preparation_path": {"const": "config/q15/q15-r-p4-k.preparation.json"},
        "p4_k_preparation_sha256": {"const": "c56ae3dc74142d244e448b9a6f638960f0cce1eb1a9e7a106fea90a4bcf55e0f"},
        "p4_d_acceptance_path": {"const": "config/q15/q15-r-p4-d-acceptance-v1.json"},
        "p4_d_acceptance_sha256": {"const": "1645c2a7fb356272afbf9377b99784e307f54f8a7df5fbb09f46d70edae3c521"},
        "p4_f_acceptance_path": {"const": "config/q15/q15-r-p4-f-acceptance-v1.json"},
        "p4_f_acceptance_sha256": {"const": "ae879bd113939ee06fd3673c0f14d054d92d6c30c0162ffa6727d2a42973cb8c"},
        "adr_0066_path": {"const": "docs/decisions/0066-q15-r-offline-signer-custody.md"},
        "adr_0066_sha256": {"const": "3177e68ae602d6bc81693c11985a0c5dae239e35a8080ff2dd13efd89a5174cc"},
        "adr_0070_path": {"const": "docs/decisions/0070-q15-r-allowed-signers-binding.md"},
        "adr_0070_sha256": {"const": "544e300d04b7bdfb721f8dd10c314977befc2d6d448a84324182349c08e5d6ed"}
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/decision"}
    },
    "owner_input_contract": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/unresolvedInput"}
    },
    "fixed_accepted_policy": {
      "const": {
        "key_type": "ED25519",
        "private_key_location": "OFF_STAND_ONLY",
        "private_key_in_repository_allowed": false,
        "stand_private_key_prohibited": true,
        "stand_private_key_allowed": false,
        "signature_scheme": "OPENSSH-SSHSIG-ED25519-SHA512-v1",
        "signature_principal": "cpu-prefetch-q15-authorization",
        "signature_namespace": "cpu-prefetch-q15-authorization",
        "allowed_signers_destination": "/etc/cpu-prefetch/q15/allowed_signers",
        "allowed_signers_owner": "root",
        "allowed_signers_group": "cpu-prefetch-q15-auditor",
        "allowed_signers_mode": "0640",
        "canonical_artifact_profile": "OPENSSH-ALLOWED-SIGNERS-SINGLE-ED25519-v1",
        "independent_sha256_and_fingerprint_verification_required": true
      }
    },
    "proposed_gate_graph": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "state", "scope"],
        "properties": {
          "gate_id": {"enum": ["Q15-R-P4-K-D", "Q15-R-P4-K-A", "Q15-R-P4-K-R", "Q15-R-P5"]},
          "state": {"type": "string", "pattern": "^(PROPOSED_|NOT_PREPARED_)[A-Z0-9_]+$"},
          "scope": {"type": "string", "minLength": 1}
        }
      }
    },
    "minimum_owner_inputs_before_exact_acceptance": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "question", "allowed_answers", "answer"],
        "properties": {
          "question_id": {"pattern": "^P4K-Q[1-3]$"},
          "question": {"type": "string", "minLength": 1},
          "allowed_answers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "answer": {"type": "null"}
        }
      }
    },
    "authority_boundary": {
      "const": {
        "repository_local_decision_input_bundle_preparation_authorized": true,
        "repository_local_acceptance_adr_or_successor_template_creation_authorized": false,
        "stand_access_authorized": false,
        "key_read_generation_import_copy_fingerprint_or_use_authorized": false,
        "public_key_or_allowed_signers_artifact_creation_authorized": false,
        "private_key_in_repository_or_on_stand_authorized": false,
        "signing_or_issuance_authorized": false,
        "p4_k_a_authorized": false,
        "p4_k_r_authorized": false,
        "transfer_install_setup_or_path_creation_authorized": false,
        "p4_r_i_or_p4_r_c_authorized": false,
        "q15_r_or_q15_w_authorized": false,
        "platform_controls_authorized": false,
        "calibration_pilot_measurement_or_confirmatory_authorized": false
      }
    }
  },
  "$defs": {
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "classification",
        "subject",
        "options_considered",
        "recommended_option",
        "selected_option",
        "state",
        "evidence",
        "scientific_effect",
        "compatibility_effect",
        "owner",
        "deadline_gate",
        "supersession_rule"
      ],
      "properties": {
        "decision_id": {"pattern": "^D-0(76|77|78|79)$"},
        "classification": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "options_considered": {"$ref": "#/$defs/nonemptyStrings"},
        "recommended_option": {"type": "string", "minLength": 1},
        "selected_option": {"type": "null"},
        "state": {"type": "string", "pattern": "^PROPOSED_[A-Z_]+$"},
        "evidence": {"$ref": "#/$defs/nonemptyStrings"},
        "scientific_effect": {"type": "string", "minLength": 1},
        "compatibility_effect": {"type": "string", "minLength": 1},
        "owner": {"$ref": "#/$defs/nonemptyStrings"},
        "deadline_gate": {"type": "string", "minLength": 1},
        "supersession_rule": {"type": "string", "minLength": 1}
      }
    },
    "unresolvedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "decision_id", "state", "value"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "decision_id": {"pattern": "^D-0(76|77|78|79)$"},
        "state": {"const": "UNRESOLVED"},
        "value": {"type": "null"}
      }
    }
  }
}
