{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:pilot-candidate-external-contract:v9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "archive",
    "sidecar",
    "manifest",
    "sha256s",
    "sbom",
    "inventory",
    "worker",
    "source_revision",
    "custody",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "cpu-prefetch-stage17-pilot-candidate-external-contract/5"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "archive": {
      "$ref": "#/$defs/external"
    },
    "sidecar": {
      "$ref": "#/$defs/sidecar"
    },
    "manifest": {
      "allOf": [
        {
          "$ref": "#/$defs/member"
        },
        {
          "type": "object",
          "required": [
            "bundle_profile"
          ],
          "properties": {
            "bundle_profile": {
              "enum": [
                "STAGE17-PILOT-CANDIDATE-BUNDLE-v23",
                "STAGE17-PILOT-CANDIDATE-BUNDLE-v24",
                "STAGE17-HERMETIC-DRY-RUN-BUNDLE-v19",
                "STAGE17-HERMETIC-DRY-RUN-BUNDLE-v20",
                "STAGE17-PILOT-CANDIDATE-BUNDLE-v25",
                "STAGE17-HERMETIC-DRY-RUN-BUNDLE-v21"
              ]
            }
          }
        }
      ]
    },
    "sha256s": {
      "$ref": "#/$defs/member"
    },
    "sbom": {
      "$ref": "#/$defs/member"
    },
    "inventory": {
      "$ref": "#/$defs/member"
    },
    "worker": {
      "allOf": [
        {
          "$ref": "#/$defs/member"
        },
        {
          "type": "object",
          "required": [
            "role",
            "runtime_profile",
            "supported_actions"
          ],
          "properties": {
            "role": {
              "const": "STAGE17_FIXED_ACTION_WORKER"
            },
            "runtime_profile": {
              "const": "STAGE17-FIXED-ACTION-WORKER-v4"
            },
            "supported_actions": {
              "const": [
                "Q15-R",
                "Q15-W",
                "Q16a",
                "Q16b",
                "Q16c",
                "STAGE17-BLINDED-PILOT",
                "Q16A-DURATION-DISCOVERY"
              ]
            }
          }
        }
      ]
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_locator",
        "sidecar_locator",
        "primary_domain_id",
        "secondary_domain_id"
      ],
      "properties": {
        "archive_locator": {
          "type": "string",
          "minLength": 1
        },
        "sidecar_locator": {
          "type": "string",
          "minLength": 1
        },
        "primary_domain_id": {
          "type": "string",
          "minLength": 1
        },
        "secondary_domain_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pilot",
        "confirmatory",
        "phase18"
      ],
      "properties": {
        "pilot": {
          "const": false
        },
        "confirmatory": {
          "const": false
        },
        "phase18": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "size_bytes",
        "sha256",
        "exact_ascii"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "exact_ascii": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}  [A-Za-z0-9._-]+\\n$"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "member_path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "member_path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
