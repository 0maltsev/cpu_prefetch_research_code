{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:fixed-phase-actions:v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "protocol_version", "predecessor", "worker_role", "runtime_profile", "actions", "execution_policy", "phase18_authority"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-fixed-phase-actions/3"},
    "profile_id": {"const": "STAGE17-FIXED-PHASE-ACTIONS-v3"},
    "protocol_version": {"const": "2.0.0-pre.2"},
    "predecessor": {"$ref": "#/$defs/binding"},
    "worker_role": {"const": "STAGE17_FIXED_ACTION_WORKER"},
    "runtime_profile": {"const": "STAGE17-FIXED-ACTION-WORKER-v3"},
    "actions": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/action"}},
    "execution_policy": {"type": "object", "additionalProperties": false, "required": ["entrypoint", "request_transport", "authority_context_transport", "output_transport", "shell", "caller_command_argv_stdin", "one_attempt", "retries", "typed_result_required", "process_group_quiescence_required", "streaming_verification", "test_schema_allowed"], "properties": {"entrypoint": {"const": "--execute-fixed-stage17-action-v3"}, "request_transport": {"const": "INHERITED_SEALED_REGULAR_FILE_FD"}, "authority_context_transport": {"const": "CONTROLLER_GENERATED_INHERITED_SEALED_REGULAR_FILE_FD"}, "output_transport": {"const": "PINNED_OWNER_DIRECTORY_FD"}, "shell": {"const": false}, "caller_command_argv_stdin": {"const": false}, "one_attempt": {"const": true}, "retries": {"const": 0}, "typed_result_required": {"const": true}, "process_group_quiescence_required": {"const": true}, "streaming_verification": {"const": true}, "test_schema_allowed": {"const": false}}},
    "phase18_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["role", "schema_identity", "schema_path", "cardinality", "file_pattern", "media_type"], "properties": {"role": {"type": "string", "minLength": 1}, "schema_identity": {"type": ["string", "null"]}, "schema_path": {"type": ["string", "null"]}, "cardinality": {"enum": ["EXACTLY_ONE", "PER_RUN"]}, "file_pattern": {"type": "string", "minLength": 1}, "media_type": {"enum": ["application/json", "application/octet-stream"]}}},
    "permission": {"type": "object", "additionalProperties": false, "required": ["read_only_observation", "privileged_controls", "calibration", "pilot_execution", "measurement", "phase18"], "properties": {"read_only_observation": {"type": "boolean"}, "privileged_controls": {"type": "boolean"}, "calibration": {"type": "boolean"}, "pilot_execution": {"type": "boolean"}, "measurement": {"type": "boolean"}, "phase18": {"const": false}}},
    "action": {"type": "object", "additionalProperties": false, "required": ["ordinal", "action_id", "required_state", "required_resolution_ids", "authorization_resolution_id", "runtime_source", "privileged", "calibration", "pilot", "requires_restoration", "permission_matrix", "outputs"], "properties": {"ordinal": {"type": "integer", "minimum": 1, "maximum": 6}, "action_id": {"enum": ["Q15-R", "Q15-W", "Q16a", "Q16b", "Q16c", "STAGE17-BLINDED-PILOT"]}, "required_state": {"enum": ["PREFLIGHT_ACCEPTED", "READY_FOR_STAGE17_PHASE_AUTHORIZATION"]}, "required_resolution_ids": {"type": "array", "minItems": 3, "maxItems": 9, "uniqueItems": true, "items": {"type": "string", "pattern": "^S17-EXT-00[1-9]$"}}, "authorization_resolution_id": {"type": ["string", "null"], "pattern": "^S17-EXT-[0-9]{3}$"}, "runtime_source": {"enum": ["EXT002_EXT003_ACCEPTED_RUNTIME", "EXT006_RELEASE_RUNTIME"]}, "privileged": {"type": "boolean"}, "calibration": {"type": "boolean"}, "pilot": {"type": "boolean"}, "requires_restoration": {"type": "boolean"}, "permission_matrix": {"$ref": "#/$defs/permission"}, "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output"}}}}
  }
}
