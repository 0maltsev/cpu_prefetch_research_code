{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cpu-prefetch/implementation/join-audit-v1.schema.json",
  "title": "Implementation-owned Stage 12 exact reconciliation audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_version", "run_id", "join_status",
    "producer_rows", "accepted_rows", "full_rows", "consumer_rows",
    "source_artifacts", "issues", "joined_artifact", "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-join-audit/1"},
    "protocol_version": {"const": "2.0.0-pre.2"},
    "run_id": {"type": "string", "minLength": 1},
    "join_status": {"enum": ["FAILED", "PASSED"]},
    "producer_rows": {"type": "integer", "minimum": 0},
    "accepted_rows": {"type": "integer", "minimum": 0},
    "full_rows": {"type": "integer", "minimum": 0},
    "consumer_rows": {"type": "integer", "minimum": 0},
    "source_artifacts": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/artifact"}, {"$ref": "#/$defs/artifact"}
      ],
      "items": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["failure_class", "category", "path", "rule_id", "message"],
        "properties": {
          "failure_class": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "rule_id": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "joined_artifact": {"oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"join_status": {"const": "PASSED"}}, "required": ["join_status"]},
      "then": {"properties": {"issues": {"maxItems": 0}, "joined_artifact": {"$ref": "#/$defs/artifact"}}}
    },
    {
      "if": {"properties": {"join_status": {"const": "FAILED"}}, "required": ["join_status"]},
      "then": {"properties": {"issues": {"minItems": 1}, "joined_artifact": {"type": "null"}}}
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
