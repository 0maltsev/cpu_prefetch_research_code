{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:read-only-preflight-supporting-contract:v12",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "protocol_version", "fixed_action_plan", "target", "pilot_candidate", "capture", "evidence_root", "pre_marker_predecessor", "post_marker_predecessor", "action_revalidation_predecessor", "prospective_local_action_identities", "remote_runtime_identity_policy", "limits", "stop_policy", "retention_policy", "authority_boundary"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-read-only-preflight-supporting-contract/12"},
    "contract_id": {"type": "string", "minLength": 1}, "protocol_version": {"const": "2.0.0-pre.3"},
    "fixed_action_plan": {"allOf": [{"$ref": "#/$defs/typed_binding"}, {"properties": {"schema_identity": {"const": "cpu-prefetch-stage17-read-only-preflight-fixed-action-plan/6"}}}]},
    "target": {"type": "object", "additionalProperties": false, "required": ["stand_id", "ssh_target", "known_hosts_host", "pinned_host_key_evidence", "pinned_known_hosts", "transport_identity"], "properties": {
      "stand_id": {"type": "string", "minLength": 1}, "ssh_target": {"type": "string", "minLength": 1}, "known_hosts_host": {"type": "string", "minLength": 1},
      "pinned_host_key_evidence": {"allOf": [{"$ref": "#/$defs/typed_binding"}, {"properties": {"schema_identity": {"const": "cpu-prefetch-stage17-pinned-host-key-evidence/1"}}}]},
      "pinned_known_hosts": {"$ref": "#/$defs/file_binding"}, "transport_identity": {"$ref": "#/$defs/external_file_binding"}
    }},
    "pilot_candidate": {"type": "object", "additionalProperties": false, "required": ["contract", "archive_locator", "sidecar_locator", "bundle_root_locator"], "properties": {"contract": {"allOf": [{"$ref": "#/$defs/typed_binding"}, {"properties": {"schema_identity": {"const": "cpu-prefetch-stage17-pilot-candidate-external-contract/1"}}}]}, "archive_locator": {"type": "string", "pattern": "^/"}, "sidecar_locator": {"type": "string", "pattern": "^/"}, "bundle_root_locator": {"type": "string", "pattern": "^/"}}},
    "capture": {"type": "object", "additionalProperties": false, "required": ["capture_id", "captured_at_utc"], "properties": {"capture_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}, "captured_at_utc": {"$ref": "#/$defs/exact_second_utc"}}},
    "evidence_root": {"type": "string", "pattern": "^/"},
    "pre_marker_predecessor": {"$ref": "#/$defs/external_file_binding"},
    "post_marker_predecessor": {"$ref": "#/$defs/external_file_binding"},
    "action_revalidation_predecessor": {"$ref": "#/$defs/external_file_binding"},
    "prospective_local_action_identities": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/executor_identity"}, {"$ref": "#/$defs/collector_identity"}], "items": false},
    "remote_runtime_identity_policy": {"const": {"source_input_id": "S17-EXT-002", "identity_classes": ["REMOTE_EXECUTABLE", "REMOTE_MODULE", "REMOTE_DEPENDENCY"], "prospective_values_present": false}},
    "limits": {"$ref": "#/$defs/limits"},
    "stop_policy": {"const": "STOP_ON_FIRST_MISMATCH_NONZERO_EXIT_TIMEOUT_OR_OUTPUT_LIMIT"},
    "retention_policy": {"const": "CREATE_EXCLUSIVE_APPEND_ONLY_RETAIN_SUCCESS_FAILURE_AND_PARTIAL_NO_DELETE"},
    "authority_boundary": {"$ref": "#/$defs/permissions"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exact_second_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "file_binding": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "external_file_binding": {"type": "object", "additionalProperties": false, "required": ["locator", "size_bytes", "sha256"], "properties": {"locator": {"type": "string", "pattern": "^/"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "typed_binding": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256", "schema_identity"], "properties": {"path": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "schema_identity": {"type": "string", "minLength": 1}}},
    "action_identity": {"type": "object", "additionalProperties": false, "required": ["identity_id", "role", "execution_path", "source_binding"], "properties": {"identity_id": {"type": "string"}, "role": {"type": "string"}, "execution_path": {"type": "string", "pattern": "^/"}, "source_binding": {"$ref": "#/$defs/file_binding"}}},
    "executor_identity": {"allOf": [{"$ref": "#/$defs/action_identity"}, {"properties": {"identity_id": {"const": "STAGE17_READ_ONLY_PREFLIGHT_EXECUTOR"}, "role": {"const": "EXECUTOR"}}}]},
    "collector_identity": {"allOf": [{"$ref": "#/$defs/action_identity"}, {"properties": {"identity_id": {"const": "STAGE17_READ_ONLY_PREFLIGHT_COLLECTOR"}, "role": {"const": "COLLECTOR"}}}]},
    "limits": {"const": {"max_commands": 6, "max_wall_seconds": 180, "max_total_output_bytes": 6291456, "max_output_bytes_per_observation": 1048576, "timeout_seconds_per_observation": 30, "attempts_per_observation": 1, "retries": 0}},
    "permissions": {"const": {"stand_read_only": true, "stand_mutation": false, "privileged_controls": false, "qualification": false, "calibration": false, "pilot_execution": false, "measurement": false, "stage18_authority": false}}
  }
}
