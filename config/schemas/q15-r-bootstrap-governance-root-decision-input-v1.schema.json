  "properties": {
    "schema_version": {"const": "cpu-prefetch-q15-r-bootstrap-governance-root-decision-input/1"},
    "bundle_id": {"const": "Q15-R-BOOTSTRAP-GOVERNANCE-ROOT-DECISION-INPUT-20260825-01"},
    "protocol_version": {"const": "2.0.0-pre.2"},
    "status": {"const": "PROPOSED_D087_D092_EXTERNAL_GENESIS_IDENTITY_AND_OFFLINE_CUSTODY_EVIDENCE_REQUIRED_NO_KEY_OR_EXECUTION_AUTHORITY"},
    "lineage": {"type": "object", "additionalProperties": false, "required": ["p4_k_a_policy_acceptance_path", "p4_k_a_policy_acceptance_sha256", "bootstrap_blocking_adr_path", "bootstrap_blocking_adr_sha256", "generic_controller_profile_path", "generic_controller_profile_sha256"], "properties": {
