{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:operational-evidence-admission-policy:v10",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "policy_id", "policy_version", "protocol_version", "predecessor_status", "graph_sha256", "catalog_sha256", "genesis_record_sha256", "resolution_schema_sha256", "bindings", "runtime_closure_keys", "runtime_closure", "entries", "admission_contract", "checked_in_state", "stage18_authority"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-operational-evidence-admission-policy/10"},
    "policy_id": {"const": "STAGE17-OPERATIONAL-EVIDENCE-ADMISSION-POLICY-v10"},
    "policy_version": {"const": "10"}, "protocol_version": {"const": "2.0.0-pre.2"},
    "predecessor_status": {"const": "REJECTED_FAIL_OPEN_PREDECESSOR"},
    "graph_sha256": {"$ref": "#/$defs/sha256"}, "catalog_sha256": {"$ref": "#/$defs/sha256"}, "genesis_record_sha256": {"$ref": "#/$defs/sha256"}, "resolution_schema_sha256": {"$ref": "#/$defs/sha256"},
    "bindings": {"type": "object", "minProperties": 20, "additionalProperties": {"$ref": "#/$defs/binding"}},
    "runtime_closure_keys": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
    "runtime_closure": {"type": "object", "minProperties": 8, "additionalProperties": {"$ref": "#/$defs/binding"}},
    "entries": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["input_id", "status", "verifier_id", "verifier_version"], "properties": {"input_id": {"pattern": "^S17-EXT-[0-9]{3}$"}, "status": {"const": "IMPLEMENTED"}, "verifier_id": {"const": "STAGE17-SEMANTIC-ADMISSION-VERIFIER"}, "verifier_version": {"const": "10"}}}},
    "admission_contract": {"const": {"closed_role_schema_registry": true, "actual_json_schema_validation": true, "exact_artifact_bytes_rehashed": true, "generic_payload_sufficient": false, "boolean_only_claim_sufficient": false, "self_selected_trust_root": false, "fixed_worker_snapshot": true, "typed_result_required": true, "synthetic_resolves_checked_in_state": false}},
    "checked_in_state": {"const": {"current_state": "PREPARED", "resolutions": 0, "transitions": 0, "action_ready": false, "pilot_ready": false, "stand": "NOT_ACCESSED"}},
    "stage18_authority": {"const": false}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "binding": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}
}
