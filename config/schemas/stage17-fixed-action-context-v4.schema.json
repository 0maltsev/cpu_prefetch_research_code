{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:cpu-prefetch:stage17:fixed-action-context:v4",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "authorization_id",
        "authorization_sha256",
        "request_id",
        "request_sha256",
        "session_id",
        "attempt_id",
        "action_id",
        "fixed_action_definition_sha256",
        "runtime_sha256",
        "release_sha256",
        "predecessor_sha256s",
        "issued_at_epoch_seconds",
        "expires_at_epoch_seconds",
        "per_run_deadline_seconds",
        "synthetic_test_only",
        "phase18_authority"
    ],
    "properties": {
        "schema_version": {
            "const": "cpu-prefetch-stage17-fixed-action-context/4"
        },
        "authorization_id": {
            "type": "string",
            "minLength": 1
        },
        "authorization_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "request_id": {
            "type": "string",
            "minLength": 1
        },
        "request_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "session_id": {
            "type": "string",
            "minLength": 1
        },
        "attempt_id": {
            "type": "string",
            "minLength": 1
        },
        "action_id": {
            "enum": [
                "Q15-R",
                "Q15-W",
                "Q16a",
                "Q16b",
                "Q16c",
                "STAGE17-BLINDED-PILOT"
            ]
        },
        "fixed_action_definition_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "runtime_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "release_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "predecessor_sha256s": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/sha256"
            }
        },
        "issued_at_epoch_seconds": {
            "type": "integer",
            "minimum": 1
        },
        "expires_at_epoch_seconds": {
            "type": "integer",
            "minimum": 1
        },
        "per_run_deadline_seconds": {
            "const": 180
        },
        "synthetic_test_only": {
            "type": "boolean"
        },
        "phase18_authority": {
            "const": false
        }
    },
    "$defs": {
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        }
    }
}
