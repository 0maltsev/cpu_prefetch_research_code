{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:cpu-prefetch:stage17:pilot-attempt:v1",
  "type": "object", "additionalProperties": false,
  "required": ["attempt", "retries", "authorization_id", "authorization_sha256", "resolution_id", "resolution_sha256", "pilot_plan_sha256", "run_ids", "one_shot_marker_sha256", "actual_started_at_utc", "authorized_by_ext010", "stage18_authority"],
  "properties": {
    "attempt": {"const": 1}, "retries": {"const": 0},
    "authorization_id": {"type": "string", "minLength": 1}, "authorization_sha256": {"$ref": "#/$defs/sha"},
    "resolution_id": {"type": "string", "minLength": 1}, "resolution_sha256": {"$ref": "#/$defs/sha"},
    "pilot_plan_sha256": {"$ref": "#/$defs/sha"}, "run_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "one_shot_marker_sha256": {"$ref": "#/$defs/sha"}, "actual_started_at_utc": {"$ref": "#/$defs/utc"},
    "authorized_by_ext010": {"const": true}, "stage18_authority": {"const": false}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}}
}
