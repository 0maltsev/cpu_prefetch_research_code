    "lineage": {"type": "object", "additionalProperties": false, "required": ["decision_input_path", "decision_input_sha256", "acceptance_path", "acceptance_sha256", "p4_k_a_template_path", "p4_k_a_template_sha256", "adr_bindings"], "properties": {
      "decision_input_path": {"const": "config/q15/q15-r-p4-k-decision-input-v1.json"},
