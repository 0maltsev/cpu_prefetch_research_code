{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:cpu-prefetch:stage17:q15-w-output:v3",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "authorization_sha256", "q15_r_attempt_sha256", "q15_r_result_sha256", "session_id", "live_prestate_matches", "apply_readback", "regular_probe", "pointer_probe", "restore_readback", "restoration_verified", "quarantine_operation", "complete"],
  "properties": {"schema_version": {"const": "cpu-prefetch-stage17-q15-w-output/3"}, "authorization_sha256": {"$ref": "#/$defs/sha256"}, "q15_r_attempt_sha256": {"$ref": "#/$defs/sha256"}, "q15_r_result_sha256": {"$ref": "#/$defs/sha256"}, "session_id": {"type": "string", "minLength": 1}, "live_prestate_matches": {"const": true}, "apply_readback": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/msr"}}, "regular_probe": {"$ref": "#/$defs/probe"}, "pointer_probe": {"$ref": "#/$defs/probe"}, "restore_readback": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/msr"}}, "restoration_verified": {"const": true}, "quarantine_operation": {"type": "object", "additionalProperties": false, "required": ["performed", "reason"], "properties": {"performed": {"const": false}, "reason": {"const": "RESTORATION_VERIFIED"}}}, "complete": {"const": true}},
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "msr": {"type": "object", "additionalProperties": false, "required": ["cpu", "complete_value_hex"], "properties": {"cpu": {"enum": [0,1,26]}, "complete_value_hex": {"type": "string", "pattern": "^[0-9a-f]{16}$"}}}, "probe": {"type": "object", "additionalProperties": false, "required": ["counter_value", "accepted", "integrity_verified"], "properties": {"counter_value": {"type": "integer", "minimum": 0}, "accepted": {"const": true}, "integrity_verified": {"const": true}}}}
}
