{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:read-only-preflight-supporting-contract:v2",
  "title": "Stage 17 S17-EXT-001 read-only preflight supporting contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "protocol_version", "target", "pilot_candidate", "prospective_local_action_identities", "remote_runtime_identity_policy", "observations", "limits", "stop_policy", "retention_policy", "authority_boundary"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-read-only-preflight-supporting-contract/2"},
    "contract_id": {"type": "string", "minLength": 1},
    "protocol_version": {"const": "2.0.0-pre.2"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stand_id", "ssh_target", "pinned_host_key_evidence"],
      "properties": {
        "stand_id": {"type": "string", "minLength": 1},
        "ssh_target": {"type": "string", "minLength": 1},
        "pinned_host_key_evidence": {
          "allOf": [
            {"$ref": "#/$defs/typed_file_binding"},
            {"properties": {"schema_identity": {"const": "cpu-prefetch-stage17-pinned-host-key-evidence/1"}}}
          ]
        }
      }
    },
    "pilot_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "archive_locator", "sidecar_locator"],
      "properties": {
        "contract": {"$ref": "#/$defs/typed_file_binding"},
        "archive_locator": {"type": "string", "pattern": "^/"},
        "sidecar_locator": {"type": "string", "pattern": "^/"}
      }
    },
    "prospective_local_action_identities": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/launcher_identity"},
        {"$ref": "#/$defs/collector_identity"}
      ],
      "items": false
    },
    "remote_runtime_identity_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_input_id", "identity_classes", "prospective_values_present"],
      "properties": {
        "source_input_id": {"const": "S17-EXT-002"},
        "identity_classes": {
          "const": ["REMOTE_EXECUTABLE", "REMOTE_MODULE", "REMOTE_DEPENDENCY"]
        },
        "prospective_values_present": {"const": false}
      }
    },
    "observations": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"$ref": "#/$defs/observation_1"},
        {"$ref": "#/$defs/observation_2"},
        {"$ref": "#/$defs/observation_3"},
        {"$ref": "#/$defs/observation_4"},
        {"$ref": "#/$defs/observation_5"},
        {"$ref": "#/$defs/observation_6"}
      ],
      "items": false
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_commands", "max_wall_seconds", "max_total_output_bytes", "attempts_per_observation", "retries"],
      "properties": {
        "max_commands": {"const": 6},
        "max_wall_seconds": {"type": "integer", "minimum": 1},
        "max_total_output_bytes": {"type": "integer", "minimum": 1},
        "attempts_per_observation": {"const": 1},
        "retries": {"const": 0}
      }
    },
    "stop_policy": {"const": "STOP_ON_FIRST_MISMATCH_OR_NONZERO_EXIT"},
    "retention_policy": {"const": "CREATE_EXCLUSIVE_APPEND_ONLY_RETAIN_SUCCESS_AND_FAILURE_NO_DELETE"},
    "authority_boundary": {
      "const": {
        "stand_read_only": true,
        "stand_mutation": false,
        "privileged_controls": false,
        "qualification": false,
        "calibration": false,
        "pilot_execution": false,
        "measurement": false,
        "stage18_authority": false
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
    "file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "typed_file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256", "schema_identity"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_identity": {"type": "string", "minLength": 1}
      }
    },
    "action_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_id", "role", "execution_path", "source_path", "size_bytes", "sha256"],
      "properties": {
        "identity_id": {"type": "string"},
        "role": {"type": "string"},
        "execution_path": {"type": "string", "pattern": "^/"},
        "source_path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "launcher_identity": {
      "allOf": [
        {"$ref": "#/$defs/action_identity"},
        {"properties": {"identity_id": {"const": "LOCAL_PREFLIGHT_LAUNCHER"}, "role": {"const": "LAUNCHER"}}}
      ]
    },
    "collector_identity": {
      "allOf": [
        {"$ref": "#/$defs/action_identity"},
        {"properties": {"identity_id": {"const": "LOCAL_PREFLIGHT_COLLECTOR"}, "role": {"const": "COLLECTOR"}}}
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "local_action_identity_id", "argv_bytes_base64", "stdin_bytes_base64", "remote_command_bytes_base64", "output_locator", "output_creation", "max_output_bytes"],
      "properties": {
        "observation_id": {"type": "string"},
        "local_action_identity_id": {"enum": ["LOCAL_PREFLIGHT_LAUNCHER", "LOCAL_PREFLIGHT_COLLECTOR"]},
        "argv_bytes_base64": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/base64"}},
        "stdin_bytes_base64": {"$ref": "#/$defs/base64"},
        "remote_command_bytes_base64": {"$ref": "#/$defs/base64"},
        "output_locator": {"type": "string", "pattern": "^/"},
        "output_creation": {"const": "CREATE_EXCLUSIVE"},
        "max_output_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "observation_1": {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"observation_id": {"const": "S17-RO-PREFLIGHT-001-TARGET-AND-TRANSPORT-IDENTITY"}}}]},
    "observation_2": {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"observation_id": {"const": "S17-RO-PREFLIGHT-002-ARCHIVE-AND-SIDECAR-BYTE-VERIFICATION"}}}]},
    "observation_3": {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"observation_id": {"const": "S17-RO-PREFLIGHT-003-BUNDLE-INTERNAL-VERIFICATION"}}}]},
    "observation_4": {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"observation_id": {"const": "S17-RO-PREFLIGHT-004-NONPRIVILEGED-SELF-TESTS"}}}]},
    "observation_5": {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"observation_id": {"const": "S17-RO-PREFLIGHT-005-RUNTIME-TOOL-IDENTITIES"}}}]},
    "observation_6": {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"observation_id": {"const": "S17-RO-PREFLIGHT-006-READ-ONLY-PLATFORM-INVENTORY"}}}]}
  }
}
