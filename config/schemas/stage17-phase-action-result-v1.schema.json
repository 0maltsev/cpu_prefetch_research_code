{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:phase-action-result:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "result_id", "action_id", "authorization_id", "authorization_sha256", "attempt_id", "actual_started_at_utc", "actual_completed_at_utc", "before_sha256", "after_sha256", "readback_sha256", "probe_sha256", "restoration", "quarantine", "completed", "retry_allowed", "phase18_authority"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-phase-action-result/1"},
    "result_id": {"type": "string", "minLength": 1}, "action_id": {"enum": ["Q15-R", "Q15-W", "Q16a", "Q16b", "Q16c", "STAGE17-BLINDED-PILOT"]},
    "authorization_id": {"type": "string", "minLength": 1}, "authorization_sha256": {"$ref": "#/$defs/sha256"}, "attempt_id": {"type": "string", "minLength": 1},
    "actual_started_at_utc": {"$ref": "#/$defs/utc"}, "actual_completed_at_utc": {"$ref": "#/$defs/utc"},
    "before_sha256": {"$ref": "#/$defs/sha256"}, "after_sha256": {"$ref": "#/$defs/sha256"}, "readback_sha256": {"$ref": "#/$defs/sha256"}, "probe_sha256": {"$ref": "#/$defs/sha256"},
    "restoration": {"enum": ["NOT_APPLICABLE", "VERIFIED"]}, "quarantine": {"const": false}, "completed": {"const": true}, "retry_allowed": {"const": false}, "phase18_authority": {"const": false}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"}}
}
