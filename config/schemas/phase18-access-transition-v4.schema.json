{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:cpu-prefetch:phase18:access-transition:v4",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "sequence_number", "from_state", "to_state", "previous_transition_sha256", "authorization_id", "authorization_sha256", "evidence_sha256s", "actor", "reviewer", "timestamp_utc", "authority_scope", "stage17_authority_used", "automatic_transition", "retry_allowed"],
  "properties": {"schema_version": {"const": "cpu-prefetch-phase18-access-transition/4"}, "sequence_number": {"type": "integer", "minimum": 1, "maximum": 7}, "from_state": {"$ref": "#/$defs/state"}, "to_state": {"$ref": "#/$defs/state"}, "previous_transition_sha256": {"$ref": "#/$defs/sha"}, "authorization_id": {"type": "string", "minLength": 1}, "authorization_sha256": {"$ref": "#/$defs/sha"}, "evidence_sha256s": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha"}}, "actor": {"type": "string", "minLength": 1}, "reviewer": {"type": "string", "minLength": 1}, "timestamp_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}, "authority_scope": {"const": "PHASE18_ACCESS_TRANSITION_ONLY"}, "stage17_authority_used": {"const": false}, "automatic_transition": {"const": false}, "retry_allowed": {"const": false}},
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "state": {"enum": ["PLANNED", "COLLECTED_SEALED", "TRAINING_OPEN", "SELECTION_FROZEN", "VALIDATION_UNSEALED", "H3_EVALUATED", "H1H2_RELEASED", "ARCHIVED"]}}
}
