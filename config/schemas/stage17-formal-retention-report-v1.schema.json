{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "plan_sha256",
    "mapping_id",
    "whole_plots",
    "native_results_after_cleanup",
    "captures",
    "restoration_verified",
    "mandatory_failure",
    "scientific_validity",
    "execution_authority",
    "phase18_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "cpu-prefetch-stage17-formal-retention-report/1"
    },
    "action_id": {
      "enum": [
        "Q16a",
        "Q16b",
        "Q16c"
      ]
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mapping_id": {
      "type": "string",
      "minLength": 1
    },
    "whole_plots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "apply_readback",
          "restore_readback",
          "restoration_verified"
        ],
        "properties": {
          "state": {
            "enum": [
              "H0",
              "H1"
            ]
          },
          "apply_readback": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "complete_value_hex"
              ],
              "properties": {
                "cpu": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "complete_value_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                }
              }
            }
          },
          "restore_readback": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "complete_value_hex"
              ],
              "properties": {
                "cpu": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "complete_value_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                }
              }
            }
          },
          "restoration_verified": {
            "const": true
          }
        }
      }
    },
    "native_results_after_cleanup": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1
      }
    },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "artifacts",
          "native_complete"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "artifacts": {
            "type": "array",
            "minItems": 6,
            "maxItems": 9,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file_name",
                "size_bytes",
                "sha256"
              ],
              "properties": {
                "file_name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "native_complete": {
            "const": true
          }
        }
      }
    },
    "restoration_verified": {
      "const": true
    },
    "mandatory_failure": {
      "const": false
    },
    "scientific_validity": {
      "const": "NOT_ASSESSED"
    },
    "execution_authority": {
      "const": false
    },
    "phase18_authority": {
      "const": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:formal-retention-report:v1",
  "description": "Complete native custody receipt only. Scientific validity, independent reconciliation and estimator eligibility remain unassessed. Failed-prefix reports are preserved but not admitted by this complete-family schema."
}
