{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:q15-r-p4-k-r-d097-action-authorization:v1",
  "title": "Exact one-shot D-097 public-only P4-K-R authorization",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action_python_absolute_path": {"const": "/usr/bin/python3"},
    "action_python_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "authority_boundary": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "authorization_id": {"const": "Q15-R-P4-K-R-D097-AUTHORIZATION-20260826-01"},
    "bootstrap_allowed_signers_absolute_path": {"type": "string"},
    "bootstrap_allowed_signers_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "bootstrap_fingerprint": {"type": "string"},
    "canonicalization": {"const": "JCS-I64-v1"},
    "d095_terminal_evidence_path": {"type": "string"},
    "d095_terminal_evidence_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "d096_complete_evidence_path": {"type": "string"},
    "d096_complete_evidence_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "decision_adr_path": {"type": "string"},
    "decision_adr_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "decision_id": {"const": "D-097"},
    "exact_validity_seconds": {"const": 1800},
    "expires_at_utc": {"type": "string"},
    "fixed_environment": {"type": "object"},
    "issued_at_utc": {"type": "string"},
    "overwrite_allowed": {"const": false},
    "p5_or_later_authorized": {"const": false},
    "predecessor_template_path": {"type": "string"},
    "predecessor_template_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "protocol_version": {"const": "2.0.0-pre.2"},
    "public_source_hashes": {"type": "object", "minProperties": 9, "maxProperties": 9, "additionalProperties": {"pattern": "^[0-9a-f]{64}$"}},
    "public_source_root_absolute_path": {"type": "string"},
    "renewal_allowed": {"const": false},
    "retry_count": {"const": 0},
    "review_attempt_count": {"const": 1},
    "review_output_root_absolute_path": {"type": "string"},
    "review_principal": {"const": "cpu-prefetch-bootstrap-owner"},
    "review_separation_policy": {"const": "EXPLICIT_SINGLE_OWNER_WAIVER_ACCEPTED_NO_INDEPENDENT_DETECTION"},
    "review_tool_path": {"const": "tools/execute_d097_p4_k_r.py"},
    "review_tool_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "reuse_allowed": {"const": false},
    "schema_version": {"const": "cpu-prefetch-q15-r-p4-k-r-d097-action-authorization/1"},
    "signature_namespace": {"const": "cpu-prefetch-q15-authorization"},
    "signature_principal": {"const": "cpu-prefetch-q15-authorization"},
    "signature_scheme": {"const": "OPENSSH-SSHSIG-ED25519-SHA512-v1"},
    "source_commit": {"pattern": "^[0-9a-f]{40}$"},
    "ssh_keygen_absolute_path": {"const": "/usr/bin/ssh-keygen"},
    "ssh_keygen_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "AUTHORIZED_ONE_BOOTSTRAP_SIGNATURE_AND_ONE_PUBLIC_ONLY_P4_K_R_REVIEW"},
    "transaction_id": {"const": "Q15-R-P4-K-R-D097-20260826-01"},
    "user_acceptance": {"type": "string", "minLength": 1},
    "waiver_path": {"type": "string"},
    "waiver_sha256": {"pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["action_python_absolute_path", "action_python_sha256", "authority_boundary", "authorization_id", "bootstrap_allowed_signers_absolute_path", "bootstrap_allowed_signers_sha256", "bootstrap_fingerprint", "canonicalization", "d095_terminal_evidence_path", "d095_terminal_evidence_sha256", "d096_complete_evidence_path", "d096_complete_evidence_sha256", "decision_adr_path", "decision_adr_sha256", "decision_id", "exact_validity_seconds", "expires_at_utc", "fixed_environment", "issued_at_utc", "overwrite_allowed", "p5_or_later_authorized", "predecessor_template_path", "predecessor_template_sha256", "protocol_version", "public_source_hashes", "public_source_root_absolute_path", "renewal_allowed", "retry_count", "review_attempt_count", "review_output_root_absolute_path", "review_principal", "review_separation_policy", "review_tool_path", "review_tool_sha256", "reuse_allowed", "schema_version", "signature_namespace", "signature_principal", "signature_scheme", "source_commit", "ssh_keygen_absolute_path", "ssh_keygen_sha256", "status", "transaction_id", "user_acceptance", "waiver_path", "waiver_sha256"]
}
