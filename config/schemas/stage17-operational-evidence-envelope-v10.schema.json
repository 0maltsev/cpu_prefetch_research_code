{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:operational-evidence-envelope:v10",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "envelope_id", "input_id", "predecessor", "semantic_policy", "semantic_verifier", "authorization", "supporting_contract", "effective_action_plan", "successor_action_plan", "runtime_implementations", "stage18_authority"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-operational-evidence-envelope/10"},
    "envelope_id": {"type": "string", "minLength": 1}, "input_id": {"const": "S17-EXT-001"},
    "predecessor": {"type": "object"}, "semantic_policy": {"$ref": "#/$defs/file_binding"},
    "semantic_verifier": {"const": {"verifier_id": "STAGE17-S17-EXT-001-SEMANTIC-VERIFIER", "verifier_version": "10"}},
    "authorization": {"$ref": "#/$defs/typed_binding"}, "supporting_contract": {"$ref": "#/$defs/typed_binding"},
    "effective_action_plan": {"$ref": "#/$defs/typed_binding"}, "successor_action_plan": {"$ref": "#/$defs/typed_binding"},
    "runtime_implementations": {"type": "object", "additionalProperties": {"$ref": "#/$defs/file_binding"}, "minProperties": 17, "maxProperties": 17},
    "stage18_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_binding": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "typed_binding": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256", "schema_identity"], "properties": {"path": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "schema_identity": {"type": "string", "minLength": 1}}}
  }
}
