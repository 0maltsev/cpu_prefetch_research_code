{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:q15-r-p4-k-a-controller-admission:v1",
  "title": "Exact future P4-K-A fixed-controller admission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "controller_profile_id", "gate_id", "status", "source_revision", "controller_binary_sha256", "binding_id", "authorization_id", "authorization_core_sha256", "issued_at_utc", "expires_at_utc", "detached_signature_artifact_id", "detached_signature_sha256", "signature_verification_artifact_id", "signature_verification_sha256", "signature_scheme", "signature_namespace", "authorization_principal", "bootstrap_signer_fingerprint", "bootstrap_trust_artifact_id", "bootstrap_trust_sha256", "auditor_review_artifact_id", "auditor_review_sha256", "offline_environment_artifact_id", "offline_environment_sha256", "toolchain_artifact_id", "toolchain_sha256", "custody_artifact_id", "custody_sha256", "public_export_transaction_id", "public_export_root", "key_generation_tool_path", "key_generation_argv", "public_extraction_tool_path", "public_extraction_argv", "fixed_environment", "secret_input", "limits", "command_graph", "action_attempt_count", "retry_count", "network_unavailable_verified", "public_export_outside_repository_and_stand_verified", "create_exclusive_public_outputs", "overwrite_repair_cleanup_allowed", "stop_before_p4_k_r", "automatic_continuation_allowed"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-q15-r-p4-k-a-controller-admission/1"},
    "protocol_version": {"const": "2.0.0-pre.2"},
    "controller_profile_id": {"const": "Q15-R-P4-K-A-FIXED-CEREMONY-CONTROLLER-v1"},
    "gate_id": {"const": "Q15-R-P4-K-A"},
    "status": {"const": "AUTHORIZED"},
    "source_revision": {"type": "string", "minLength": 1},
    "controller_binary_sha256": {"$ref": "#/$defs/sha256"},
    "binding_id": {"type": "string", "minLength": 1},
    "authorization_id": {"type": "string", "minLength": 1},
    "authorization_core_sha256": {"$ref": "#/$defs/sha256"},
    "issued_at_utc": {"$ref": "#/$defs/utc"},
    "expires_at_utc": {"$ref": "#/$defs/utc"},
    "detached_signature_artifact_id": {"type": "string", "minLength": 1},
    "detached_signature_sha256": {"$ref": "#/$defs/sha256"},
    "signature_verification_artifact_id": {"type": "string", "minLength": 1},
    "signature_verification_sha256": {"$ref": "#/$defs/sha256"},
    "signature_scheme": {"const": "OPENSSH-SSHSIG-ED25519-SHA512-v1"},
    "signature_namespace": {"const": "cpu-prefetch-q15-authorization"},
    "authorization_principal": {"const": "cpu-prefetch-q15-authorization"},
    "bootstrap_signer_fingerprint": {"type": "string", "minLength": 1},
    "bootstrap_trust_artifact_id": {"type": "string", "minLength": 1},
    "bootstrap_trust_sha256": {"$ref": "#/$defs/sha256"},
    "auditor_review_artifact_id": {"type": "string", "minLength": 1},
    "auditor_review_sha256": {"$ref": "#/$defs/sha256"},
    "offline_environment_artifact_id": {"type": "string", "minLength": 1},
    "offline_environment_sha256": {"$ref": "#/$defs/sha256"},
    "toolchain_artifact_id": {"type": "string", "minLength": 1},
    "toolchain_sha256": {"$ref": "#/$defs/sha256"},
    "custody_artifact_id": {"type": "string", "minLength": 1},
    "custody_sha256": {"$ref": "#/$defs/sha256"},
    "public_export_transaction_id": {"type": "string", "minLength": 1},
    "public_export_root": {"type": "string", "pattern": "^/"},
    "key_generation_tool_path": {"$ref": "#/$defs/directTool"},
    "key_generation_argv": {"$ref": "#/$defs/argv"},
    "public_extraction_tool_path": {"$ref": "#/$defs/directTool"},
    "public_extraction_argv": {"$ref": "#/$defs/argv"},
    "fixed_environment": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": {"name": {"enum": ["LANG", "LC_ALL", "PATH", "TZ"]}, "value": {"type": "string", "minLength": 1}}}},
    "secret_input": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "descriptor"], "properties": {"kind": {"const": "UNCAPTURED_CONTROLLING_TTY"}, "descriptor": {"type": "null"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "descriptor"], "properties": {"kind": {"const": "DEDICATED_DESCRIPTOR"}, "descriptor": {"type": "integer", "minimum": 3}}}
    ]},
    "limits": {"type": "object", "additionalProperties": false, "required": ["maximum_wall_seconds", "maximum_stdout_bytes", "maximum_stderr_bytes", "maximum_public_artifact_count"], "properties": {"maximum_wall_seconds": {"type": "integer", "minimum": 1}, "maximum_stdout_bytes": {"type": "integer", "minimum": 1}, "maximum_stderr_bytes": {"type": "integer", "minimum": 1}, "maximum_public_artifact_count": {"type": "integer", "minimum": 1}}},
    "command_graph": {"const": ["VERIFY_SIGNED_AUTHORIZATION_AND_BOOTSTRAP_TRUST", "VERIFY_OFFLINE_ENVIRONMENT_TOOLCHAIN_AND_NETWORK_STATE", "VERIFY_CUSTODY_AND_CREATE_EXCLUSIVE_PUBLIC_OUTPUTS", "GENERATE_ENCRYPTED_ED25519_PRIVATE_KEY_ONCE", "EXTRACT_ED25519_PUBLIC_KEY_ONCE", "DERIVE_ED25519_FINGERPRINT_ONCE", "CONSTRUCT_CANONICAL_ALLOWED_SIGNERS_ONCE", "CAPTURE_NONSECRET_CUSTODY_RECEIPT", "SEAL_COMPLETE_OR_PARTIAL_PUBLIC_EVIDENCE", "STOP_FOR_SEPARATE_P4_K_R"]},
    "action_attempt_count": {"const": 1},
    "retry_count": {"const": 0},
    "network_unavailable_verified": {"const": true},
    "public_export_outside_repository_and_stand_verified": {"const": true},
    "create_exclusive_public_outputs": {"const": true},
    "overwrite_repair_cleanup_allowed": {"const": false},
    "stop_before_p4_k_r": {"const": true},
    "automatic_continuation_allowed": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "directTool": {"type": "string", "pattern": "^/(?!bin/(ba)?sh$|usr/bin/(ba)?sh$|usr/bin/env$).+"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
