{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17-q15-r-software-prefetch-raw:v1",
  "title": "Q15-R raw software-prefetch CPUID/PRFCHW capability observation, pre-qualification-envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "qualification_id",
    "mapping_id",
    "observed_cpu",
    "producer_maximum_extended_leaf",
    "producer_extended_leaf_ecx",
    "producer_prfchw_supported",
    "consumer_maximum_extended_leaf",
    "consumer_extended_leaf_ecx",
    "consumer_prfchw_supported"
  ],
  "properties": {
    "schema_version": {
      "const": "cpu-prefetch-stage17-q15-r-software-prefetch-raw/1"
    },
    "session_id": {"type": "string", "minLength": 1},
    "qualification_id": {"type": "string", "minLength": 1},
    "mapping_id": {"const": "X86-64-PREFETCHW-PREFETCHT0-v1"},
    "observed_cpu": {"type": "integer", "minimum": 0},
    "producer_maximum_extended_leaf": {"type": "integer", "minimum": 0},
    "producer_extended_leaf_ecx": {"type": "integer", "minimum": 0},
    "producer_prfchw_supported": {"type": "boolean"},
    "consumer_maximum_extended_leaf": {"type": "integer", "minimum": 0},
    "consumer_extended_leaf_ecx": {"type": "integer", "minimum": 0},
    "consumer_prfchw_supported": {"type": "boolean"}
  }
}
