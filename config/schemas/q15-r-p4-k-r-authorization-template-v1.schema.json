      "signing_or_issuance_authorized": false,
      "p4_k_a_authorized": false,
      "p4_k_r_authorized": false,
      "stand_access_authorized": false,
      "transfer_install_or_setup_authorized": false,
      "p4_r_i_or_p4_r_c_authorized": false,
      "q15_r_or_q15_w_authorized": false,
      "platform_controls_authorized": false,
      "calibration_pilot_measurement_or_confirmatory_authorized": false
    }}
