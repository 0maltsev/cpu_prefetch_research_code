{
  "$id": "urn:cpu-prefetch:q15-r-controller-profile:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_boundary": {
      "additionalProperties": false,
      "properties": {
        "account_or_key_changes_authorized": {"const": false},
        "bundle_transfer_or_install_authorized": {"const": false},
        "calibration_authorized": {"const": false},
        "confirmatory_authorized": {"const": false},
        "dynamic_qualification_authorized": {"const": false},
        "measurement_authorized": {"const": false},
        "msr_access_authorized": {"const": false},
        "pilot_authorized": {"const": false},
        "q15_r_authorized": {"const": false},
        "q15_w_authorized": {"const": false},
        "real_affinity_numa_authorized": {"const": false},
        "real_pmu_authorized": {"const": false},
        "stand_access_authorized": {"const": false}
      },
      "required": [
        "account_or_key_changes_authorized",
        "bundle_transfer_or_install_authorized",
        "calibration_authorized",
        "confirmatory_authorized",
        "dynamic_qualification_authorized",
        "measurement_authorized",
        "msr_access_authorized",
        "pilot_authorized",
        "q15_r_authorized",
        "q15_w_authorized",
        "real_affinity_numa_authorized",
        "real_pmu_authorized",
        "stand_access_authorized"
      ],
      "type": "object"
    },
    "authorization_contract": {
      "const": {
        "canonicalization": "JCS-I64-v1",
        "core_schema_version": "cpu-prefetch-q15-qualification-authorization/2",
        "detached_signature_required": true,
        "independent_verification_required": true,
        "signature_namespace": "cpu-prefetch-q15-authorization",
        "signature_scheme": "OPENSSH-SSHSIG-ED25519-SHA512-v1"
      }
    },
    "command_contract": {
      "additionalProperties": false,
      "properties": {
        "arbitrary_runtime_selectors": {"const": false},
        "controller_executable": {"const": "cpu_prefetch_q15_controller"},
        "graph": {
          "const": [
            "VERIFY_AUTHORIZATION_AND_RELEASE_BINDINGS",
            "VERIFY_ROLE_AND_NEGATIVE_ACCESS_EVIDENCE",
            "CREATE_PRIVATE_SAME_BUFFER_SESSION",
            "COLLECT_FIXED_MSR_PRESTATE_AS_AUDITOR",
            "COLLECT_CLOCK",
            "COLLECT_ATOMIC_LAYOUT",
            "COLLECT_ACTUAL_CPU_MIGRATION",
            "COLLECT_ADDRESS_RESIDENCY",
            "COLLECT_SOFTWARE_PREFETCH_CAPABILITY",
            "COLLECT_STORAGE_CUSTODY",
            "NEGATIVE_ACCESS_CHECK",
            "RUN_H0_REGULAR_STREAM_PROBE",
            "RUN_H0_POINTER_STREAM_PROBE",
            "SEAL_Q15_R_EVIDENCE",
            "WAIT_FOR_SEPARATE_Q15_W_OR_EXPIRE_FAIL_CLOSED"
          ]
        },
        "invocation": {
          "const": [
            "cpu_prefetch_q15_controller",
            "--execute-q15-r",
            "<EXACT_AUTHORIZATION_PATH>",
            "<EXACT_DETACHED_SIGNATURE_PATH>"
          ]
        },
        "no_authority_build_behavior": {
          "const": "REFUSE_BEFORE_OPENING_ARGUMENT_PATHS"
        },
        "production_commands": {"const": ["--execute-q15-r"]},
        "retry_or_fallback": {"const": false}
      },
      "required": [
        "arbitrary_runtime_selectors",
        "controller_executable",
        "graph",
        "invocation",
        "no_authority_build_behavior",
        "production_commands",
        "retry_or_fallback"
      ],
      "type": "object"
    },
    "custody_contract": {
      "const": {
        "append_only_policy_id": "Q15-PRIMARY-APPEND-ONLY-SEAL-THEN-TRANSFER-v1",
        "output_root": "/var/lib/cpu-prefetch/q15-r",
        "partial_artifact_policy_id": "Q15-RETAIN-PARTIAL-NEVER-PROMOTE-v1",
        "primary_domain_id": "XEON-CPU-FETCH-MD3-Q15-CUSTODY",
        "recovery_policy_id": "Q15-NO-OVERWRITE-NEW-ARTIFACT-ID-v1",
        "secondary_domain_id": "DEVELOPMENT-REPOSITORY-Q15-CUSTODY",
        "transfer_policy_id": "Q15-HASHED-SEALED-TRANSFER-WITH-RECEIPT-v1"
      }
    },
    "decision_ids": {"const": ["D-057", "D-058", "D-059", "D-060"]},
    "limits": {
      "const": {
        "authorization_validity_seconds": 14400,
        "controller_start_poll_limit": 18446744073709551615,
        "external_start_watchdog_seconds": 60,
        "frame_maximum_payload_bytes": 16777216,
        "max_active_collection_wall_seconds": 1800,
        "max_artifact_count": 128,
        "max_cpu_seconds": 7200,
        "max_output_bytes": 2147483648,
        "max_same_buffer_session_wall_seconds": 14400,
        "primary_custody_quota_bytes": 4294967296,
        "worker_start_poll_limit": 18446744073709551615
      }
    },
    "principal_ids": {
      "const": [
        "cpu-prefetch-q15-operator",
        "cpu-prefetch-q15-controller",
        "cpu-prefetch-q15-custodian",
        "cpu-prefetch-q15-auditor"
      ]
    },
    "profile_id": {"const": "Q15-R-STATIC-CONTROLLER-v1"},
    "protocol_version": {"const": "2.0.0-pre.2"},
    "schema_version": {"const": "cpu-prefetch-q15-r-controller-profile/1"},
    "source_bindings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "required": ["path", "sha256"],
        "type": "object"
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "stop_conditions": {
      "const": [
        "FIRST_AUTHORIZATION_OR_RELEASE_BINDING_MISMATCH",
        "FIRST_ROLE_OR_NEGATIVE_ACCESS_MISMATCH",
        "FIRST_PEER_CREDENTIAL_OR_TRANSPORT_MISMATCH",
        "FIRST_CLOCK_AFFINITY_NUMA_RESIDENCY_FAULT_PMU_OR_MSR_FAILURE",
        "FIRST_INTEGRITY_COUNT_CANONICALIZATION_HASH_OR_CUSTODY_FAILURE",
        "FIRST_LIMIT_EXPIRY_OR_DISCONNECT",
        "PRESERVE_PARTIAL_EVIDENCE_AND_NEVER_RETRY"
      ]
    },
    "transport_contract": {
      "const": {
        "custody_transport": "INHERITED_BOUNDED_FD_CANONICAL_FRAMES-v1",
        "phase_handoff_transport": "VERSIONED_LOCAL_UNIX_DOMAIN_PEERCRED-v1",
        "same_buffer_lifetime": "ONE_PRIVATE_ANONYMOUS_MAPPING_H0_THROUGH_RESTORE_READBACK"
      }
    }
  },
  "required": [
    "authority_boundary",
    "authorization_contract",
    "command_contract",
    "custody_contract",
    "decision_ids",
    "limits",
    "principal_ids",
    "profile_id",
    "protocol_version",
    "schema_version",
    "source_bindings",
    "stop_conditions",
    "transport_contract"
  ],
  "title": "Accepted no-authority Q15-R fixed-controller profile",
  "type": "object"
}
