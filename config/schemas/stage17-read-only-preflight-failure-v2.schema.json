{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:read-only-preflight-failure:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "authorization_id", "authorization_sha256", "resolution_id", "resolution_sha256", "transition_id", "transition_sha256", "action_plan_sha256", "executor_sha256", "collector_sha256", "failed_stage", "failed_ordinal", "failed_observation_id", "completed_observation_ids", "reason_category", "reason", "actual_failed_at_utc", "duration_ns", "ssh_argv_sha256", "rendered_program_sha256", "retry_allowed", "partial_evidence_retained", "stage18_authority"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-read-only-preflight-failure/2"},
    "attempt_id": {"type": "string"}, "authorization_id": {"type": "string"}, "authorization_sha256": {"$ref": "#/$defs/sha256"},
    "resolution_id": {"type": "string"}, "resolution_sha256": {"$ref": "#/$defs/sha256"},
    "transition_id": {"type": "string"}, "transition_sha256": {"$ref": "#/$defs/sha256"},
    "action_plan_sha256": {"$ref": "#/$defs/sha256"}, "executor_sha256": {"$ref": "#/$defs/sha256"}, "collector_sha256": {"$ref": "#/$defs/sha256"},
    "failed_stage": {"enum": ["TRANSPORT", "OUTPUT_RETENTION", "RECEIPT_RETENTION", "GLOBAL_DEADLINE", "COMPLETION_RETENTION", "UNEXPECTED_OPERATIONAL_EXCEPTION"]},
    "failed_ordinal": {"type": ["integer", "null"], "minimum": 1, "maximum": 6},
    "failed_observation_id": {"type": ["string", "null"]},
    "completed_observation_ids": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"type": "string"}},
    "reason_category": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1, "maxLength": 512},
    "actual_failed_at_utc": {"$ref": "#/$defs/utc"}, "duration_ns": {"type": "integer", "minimum": 0},
    "ssh_argv_sha256": {"$ref": "#/$defs/sha256"}, "rendered_program_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "retry_allowed": {"const": false}, "partial_evidence_retained": {"const": true}, "stage18_authority": {"const": false}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}}
}
