    "authority_clock_relation": {"enum": ["LIVE_NONDECREASING", "EXPIRED", "NOT_YET_VALID", "ROLLBACK", "CLOCK_READ_FAILURE", "MONOTONIC_EXPIRED"]},
    "actual_failed_at_utc": {"$ref": "#/$defs/actual_utc"}, "duration_ns": {"type": "integer", "minimum": 0}, "ssh_argv_sha256": {"$ref": "#/$defs/sha256"}, "rendered_program_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "child_started": {"type": "boolean"}, "leader_reaped": {"type": "boolean"}, "process_group_gone": {"const": true}, "terminal_cleanup_outcome": {"$ref": "#/$defs/cleanup"}, "descendants_detected_after_leader_exit": {"type": "boolean"}, "maximum_descendant_count": {"type": "integer", "minimum": 0}, "cleanup_deadline_overrun": {"type": "boolean"}, "cleanup_diagnostics": {"type": "array", "items": {"type": "string"}}, "retry_allowed": {"const": false}, "partial_evidence_retained": {"const": true}, "stage18_authority": {"const": false}
  },
  "allOf": [{"if": {"properties": {"child_started": {"const": true}}}, "then": {"properties": {"leader_reaped": {"const": true}, "terminal_cleanup_outcome": {"not": {"const": "NOT_STARTED_GROUP_ABSENT"}}}}}, {"if": {"properties": {"child_started": {"const": false}}}, "then": {"properties": {"leader_reaped": {"const": false}, "terminal_cleanup_outcome": {"const": "NOT_STARTED_GROUP_ABSENT"}, "descendants_detected_after_leader_exit": {"const": false}, "maximum_descendant_count": {"const": 0}}}}],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "actual_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"}, "cleanup": {"enum": ["NOT_STARTED_GROUP_ABSENT", "NORMAL_LEADER_REAPED_GROUP_QUIESCENT", "SIGTERM_LEADER_REAPED_GROUP_QUIESCENT", "SIGKILL_LEADER_REAPED_GROUP_QUIESCENT", "SIGKILL_BARRIER_LEADER_REAPED_GROUP_QUIESCENT"]}}
}
