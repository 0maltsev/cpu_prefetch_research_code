{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:read-only-preflight-completion:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "authorization_id", "authorization_sha256", "resolution_id", "resolution_sha256", "transition_id", "transition_sha256", "action_plan_sha256", "executor_sha256", "collector_sha256", "ssh_argv_sha256", "completed_observation_ids", "receipt_sha256s", "actual_started_at_utc", "actual_completed_at_utc", "duration_ns", "attempts", "retries", "stage18_authority"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-read-only-preflight-completion/1"},
    "attempt_id": {"type": "string"}, "authorization_id": {"type": "string"}, "authorization_sha256": {"$ref": "#/$defs/sha256"},
    "resolution_id": {"type": "string"}, "resolution_sha256": {"$ref": "#/$defs/sha256"},
    "transition_id": {"type": "string"}, "transition_sha256": {"$ref": "#/$defs/sha256"},
    "action_plan_sha256": {"$ref": "#/$defs/sha256"}, "executor_sha256": {"$ref": "#/$defs/sha256"}, "collector_sha256": {"$ref": "#/$defs/sha256"}, "ssh_argv_sha256": {"$ref": "#/$defs/sha256"},
    "completed_observation_ids": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string"}},
    "receipt_sha256s": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/sha256"}},
    "actual_started_at_utc": {"$ref": "#/$defs/utc"}, "actual_completed_at_utc": {"$ref": "#/$defs/utc"}, "duration_ns": {"type": "integer", "minimum": 0},
    "attempts": {"const": 6}, "retries": {"const": 0}, "stage18_authority": {"const": false}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}}
}
