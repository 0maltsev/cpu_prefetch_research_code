      "acceptance_path": {"const": "config/q15/q15-r-p4-k-d-acceptance-v1.json"},
      "acceptance_sha256": {"const": "11b9c357468515145bc5e7b2b477515c814d31ec97603245eff378d0259e6be7"},
      "p4_k_a_template_path": {"const": "config/q15/q15-r-p4-k-a.authorization-template-v1.json"},
