{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:operational-evidence-envelope:v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "envelope_id", "input_id", "predecessor", "semantic_policy", "semantic_verifier", "authorization", "supporting_contract", "fixed_action_plan", "executor_implementation", "collector_implementation", "stage18_authority"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-operational-evidence-envelope/3"},
    "envelope_id": {"type": "string", "minLength": 1},
    "input_id": {"const": "S17-EXT-001"},
    "predecessor": {
      "type": "object", "additionalProperties": false,
      "required": ["graph_sha256", "catalog_sha256", "genesis_sha256", "resolution_schema_identity", "resolution_schema_sha256", "semantic_policy_v2_sha256", "adr_0106_sha256"],
      "properties": {"graph_sha256": {"$ref": "#/$defs/sha256"}, "catalog_sha256": {"$ref": "#/$defs/sha256"}, "genesis_sha256": {"$ref": "#/$defs/sha256"}, "resolution_schema_identity": {"const": "cpu-prefetch-stage17-external-input-resolution/1"}, "resolution_schema_sha256": {"$ref": "#/$defs/sha256"}, "semantic_policy_v2_sha256": {"$ref": "#/$defs/sha256"}, "adr_0106_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "semantic_policy": {"$ref": "#/$defs/file_binding"},
    "semantic_verifier": {"const": {"verifier_id": "STAGE17-S17-EXT-001-SEMANTIC-VERIFIER", "verifier_version": "3"}},
    "authorization": {"$ref": "#/$defs/typed_binding"},
    "supporting_contract": {"$ref": "#/$defs/typed_binding"},
    "fixed_action_plan": {"$ref": "#/$defs/typed_binding"},
    "executor_implementation": {"$ref": "#/$defs/file_binding"},
    "collector_implementation": {"$ref": "#/$defs/file_binding"},
    "stage18_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_binding": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"], "properties": {"path": {"type": "string"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "typed_binding": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256", "schema_identity"], "properties": {"path": {"type": "string"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "schema_identity": {"type": "string"}}}
  }
}
