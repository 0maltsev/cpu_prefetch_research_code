{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpu-prefetch:stage17:calibration-freeze:v1",
  "description": "D237 analysis-only export. This version cannot authenticate freeze authority and therefore cannot emit FROZEN. Legacy final-freeze semantics are unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "scope", "record_id", "stand_id", "source_revision", "created_at_utc", "state", "owner_decision", "plan_bindings", "calibration_bindings", "lifecycle_bindings", "probe_design_binding", "analysis_provenance_binding", "source_bindings", "outputs", "final_matrix_feasibility", "blockers", "execution_authority", "phase18_authority", "record_sha256"],
  "properties": {
    "schema_version": {"const": "cpu-prefetch-stage17-calibration-freeze/1"},
    "protocol_version": {"const": "2.0.0-pre.3"},
    "scope": {"const": "STAGE17_EXT007"},
    "record_id": {"type": "string", "minLength": 1},
    "stand_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "state": {"const": "UNRESOLVED"},
    "owner_decision": {"$ref": "#/$defs/binding"},
    "plan_bindings": {"$ref": "#/$defs/three"},
    "calibration_bindings": {
      "type": "object", "additionalProperties": false, "required": ["Q16a", "Q16b"],
      "properties": {"Q16a": {"$ref": "#/$defs/binding"}, "Q16b": {"$ref": "#/$defs/binding"}}
    },
    "lifecycle_bindings": {"$ref": "#/$defs/three"},
    "probe_design_binding": {"$ref": "#/$defs/binding"},
    "analysis_provenance_binding": {"$ref": "#/$defs/binding"},
    "source_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
    "outputs": {
      "type": "object", "additionalProperties": false,
      "required": ["q16a", "ring_geometry", "q16b", "service_rate_unit", "q16c"],
      "properties": {
        "q16a": {"type": "object"}, "ring_geometry": {"type": "array", "minItems": 6, "maxItems": 6},
        "q16b": {"type": "object"}, "service_rate_unit": {"const": "EVENTS_PER_SECOND"},
        "q16c": {
          "type": "object", "additionalProperties": false,
          "required": ["method_id", "scale_ordinal", "repetitions_per_cell", "planned_captures", "coverage_state", "inference_state", "run_sources"],
          "properties": {
            "method_id": {"const": "MATRIX-FULL-RUNCLUSTER-WHOEFFDING-BONFERRONI-v1"},
            "scale_ordinal": {"type": "integer", "minimum": 0, "maximum": 4},
            "repetitions_per_cell": {"type": "integer", "minimum": 1},
            "planned_captures": {"type": "integer", "minimum": 180},
            "coverage_state": {"enum": ["COMPLETE", "UNRESOLVED"]},
            "inference_state": {"const": "NOT_EVALUATED"},
            "run_sources": {"type": "array", "minItems": 180, "items": {"type": "object"}}
          }
        }
      }
    },
    "final_matrix_feasibility": {
      "const": {"state": "NOT_EVALUATED", "passes": null, "selected_global_scale": null, "matrix_probability_lower": null, "unresolved_inputs": ["Rtotal", "Nruns", "N_sched"]}
    },
    "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "execution_authority": {"const": false},
    "phase18_authority": {"const": false},
    "record_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["artifact_id", "size_bytes", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "three": {
      "type": "object", "additionalProperties": false, "required": ["Q16a", "Q16b", "Q16c"],
      "properties": {"Q16a": {"$ref": "#/$defs/binding"}, "Q16b": {"$ref": "#/$defs/binding"}, "Q16c": {"$ref": "#/$defs/binding"}}
    }
  }
}
